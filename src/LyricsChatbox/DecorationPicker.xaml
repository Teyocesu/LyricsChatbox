<Window x:Class="LyricsChatbox.DecorationPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Decorations" Width="840" Height="640" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}" PreviewKeyDown="WindowKeyDown">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    <ItemsPanelTemplate x:Key="DensePanel"><WrapPanel/></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="RowPanel"><VirtualizingStackPanel/></ItemsPanelTemplate>
    <Style x:Key="PickerItem" TargetType="ListBoxItem">
      <EventSetter Event="MouseDoubleClick" Handler="ItemDoubleClicked"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Entry.Name}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Shell" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Shell" Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource MutedBrush}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource TextBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PickerNavigation" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Shell" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Shell" Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="{DynamicResource SurfaceBrush}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ItemAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="7,3"/><Setter Property="MinHeight" Value="26"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="6,0,0,0"/>
    </Style>
    <Style x:Key="GroupChip" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Shell" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Shell" Property="Background" Value="{DynamicResource AccentMutedBrush}"/><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="DenseTemplate">
      <Grid Width="78" MinHeight="58" ToolTip="{Binding Entry.Name}">
        <TextBlock Text="{Binding Entry.Content}" FontFamily="Cascadia Mono, Consolas" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
        <Button Content="{Binding FavoriteGlyph}" Click="ToggleFavorite" Style="{StaticResource ItemAction}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="3,0" MinHeight="20" AutomationProperties.Name="{Binding FavoriteName}"/>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="CompactTemplate">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding Entry.Content}" FontFamily="Cascadia Mono, Consolas" FontSize="16" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Entry.Name}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Edit" Click="EditMyItem" Style="{StaticResource ItemAction}" Visibility="{Binding IsUserItem, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Edit My item"/>
          <Button Content="Delete" Click="DeleteMyItem" Style="{StaticResource ItemAction}" Visibility="{Binding IsUserItem, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Delete My item"/>
          <Button Content="{Binding FavoriteGlyph}" Click="ToggleFavorite" Style="{StaticResource ItemAction}" AutomationProperties.Name="{Binding FavoriteName}"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="WideTemplate">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{Binding Entry.Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Entry.Content}" FontFamily="Cascadia Mono, Consolas" FontSize="16" Margin="0,7,0,0" TextWrapping="NoWrap"/></StackPanel>
        <Button Grid.Column="1" Content="{Binding FavoriteGlyph}" Click="ToggleFavorite" Style="{StaticResource ItemAction}" VerticalAlignment="Center" AutomationProperties.Name="{Binding FavoriteName}"/>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ArtTemplate">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{Binding Entry.Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Entry.Content}" FontFamily="Cascadia Mono, Consolas" FontSize="15" Margin="0,7,0,0" TextWrapping="NoWrap" xml:space="preserve"/></StackPanel>
        <Button Grid.Column="1" Content="{Binding FavoriteGlyph}" Click="ToggleFavorite" Style="{StaticResource ItemAction}" VerticalAlignment="Top" AutomationProperties.Name="{Binding FavoriteName}"/>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14">
      <TextBlock Text="Decorations" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="SearchBox" TextChanged="SearchChanged" KeyDown="SearchKeyDown" AutomationProperties.Name="Search decorations"/>
        <CheckBox x:Name="FitsBox" Grid.Column="1" Content="Only show items that fit" Margin="12,0,0,0" VerticalAlignment="Center" Checked="FitsChanged" Unchecked="FitsChanged" AutomationProperties.Name="Only show decorations that fit the current VRChat Chatbox output" ToolTip="Hides decorations that would be truncated in the current VRChat Chatbox output."/>
      </Grid>
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="148"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="6">
        <ListBox x:Name="ModeList" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource PickerNavigation}" SelectionChanged="ModeChanged" AutomationProperties.Name="Decoration categories">
          <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <ListBox x:Name="GroupList" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource GroupChip}" SelectionChanged="GroupChanged" Margin="0,0,0,4" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Decoration subcategories"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
        <ListBox x:Name="DecorationList" Grid.Row="1" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource PickerItem}" SelectionChanged="DecorationSelected" KeyDown="DecorationKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Decorations"/>
        <TextBlock x:Name="EmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontStyle="Italic" Visibility="Collapsed"/>
        <Border x:Name="EditorPanel" Grid.RowSpan="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock x:Name="EditorTitle" Text="Add My item" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Name" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
              <TextBox x:Name="ItemNameBox" MaxLength="40" AutomationProperties.Name="My item name"/>
              <TextBlock Text="Type" Style="{StaticResource Caption}" Margin="0,12,0,6"/>
              <ComboBox x:Name="ItemKindBox" DisplayMemberPath="Label" SelectedValuePath="Kind" AutomationProperties.Name="My item type"/>
              <TextBlock Text="Content" Style="{StaticResource Caption}" Margin="0,12,0,6"/>
              <TextBox x:Name="ItemContentBox" MaxLength="512" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas" MinHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="My item content"/>
              <TextBlock x:Name="EditorError" Foreground="{DynamicResource WarningBrush}" Margin="0,8,0,0"/>
              <WrapPanel Margin="0,14,0,0"><Button Content="Save" Click="SaveMyItem" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" AutomationProperties.Name="Save My item"/><Button Content="Cancel" Click="CancelMyItemEditor" AutomationProperties.Name="Cancel My item editing"/></WrapPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="SelectedText" FontWeight="SemiBold"/>
        <TextBlock x:Name="PreviewStatus" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
        <TextBlock x:Name="MutationStatus" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
      </StackPanel>
      <WrapPanel Grid.Column="1" VerticalAlignment="Bottom">
        <Button x:Name="MyItemsButton" Content="My items" Click="OpenMyItems" Margin="0,0,8,0" AutomationProperties.Name="Open My items"/>
        <Button x:Name="AddItemButton" Content="+ Add item" Click="AddMyItem" Visibility="Collapsed" Margin="0,0,8,0" AutomationProperties.Name="Add My item"/>
        <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" AutomationProperties.Name="Cancel insertion"/>
        <Button x:Name="InsertButton" Content="Insert" Click="InsertSelected" Style="{StaticResource PrimaryButton}" IsEnabled="False" AutomationProperties.Name="Insert selected decoration"/>
      </WrapPanel>
    </Grid>
  </Grid>
</Window>
