<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" x:Class="LyricsChatbox.MainWindow" WindowStyle="None" Title="LyricsChatbox" Icon="Assets/AppIcon.ico" Width="1280" Height="940" MinWidth="820" MinHeight="650" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">

  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="46"/><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="10"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/></Style>
    <Style x:Key="DashboardTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="30"/><Setter Property="FontSize" Value="11"/></Style>
    <Style x:Key="StatusPill" TargetType="Border"><Setter Property="Background" Value="{DynamicResource RaisedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="10,5"/></Style>
    <DataTemplate x:Key="DashboardQuickTemplate"><Button Click="UseQuickMessage" Margin="0,0,6,6" Padding="6,8" MinHeight="38" ToolTip="Load as an unsent manual draft"><TextBlock Text="{Binding Name}" TextAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="34"/></Button></DataTemplate>
    <DataTemplate x:Key="QuickMessageTemplate"><Button Content="{Binding Name}" Click="UseQuickMessage" Margin="0,0,8,8" MinWidth="92" ToolTip="Load as an unsent manual draft"/></DataTemplate>
  </Window.Resources>
  <Grid x:Name="ContentRoot">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="194"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <Border x:Name="Sidebar" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Background="{DynamicResource SidebarBrush}" Padding="16,28,16,20">
      <DockPanel>
        <StackPanel x:Name="BrandPanel" DockPanel.Dock="Top" Margin="0,0,0,32">
          <StackPanel Orientation="Horizontal">
            <Image Source="Assets/AppIcon.png" Width="34" Height="34" Margin="4,0,10,0"/>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="LyricsChatbox" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="VersionCaption" Text="v0.5 preview" Style="{StaticResource Caption}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="10,12">
            <CheckBox x:Name="EnabledBox" Checked="EnabledChanged" Unchecked="EnabledChanged" AutomationProperties.Name="Enable Chatbox output">
              <TextBlock Text="Output" FontSize="12"/>
            </CheckBox>
          </Border>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="NavigationPanel">
          <RadioButton Tag="Home" AutomationProperties.Name="Home" GroupName="Navigation" IsChecked="True" Checked="Navigate" Style="{StaticResource NavigationItem}">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons" Text="" FontSize="20" Width="24" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <TextBlock Text="Home"/>
            </StackPanel>
          </RadioButton>
          <RadioButton Tag="Display" AutomationProperties.Name="Display" GroupName="Navigation" Checked="Navigate" Style="{StaticResource NavigationItem}">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7F4;" FontSize="20" Width="24" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <TextBlock Text="Display"/>
            </StackPanel>
          </RadioButton>
          <RadioButton Tag="Manual" AutomationProperties.Name="Manual" GroupName="Navigation" Checked="Navigate" Style="{StaticResource NavigationItem}">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8F2;" FontSize="20" Width="24" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <TextBlock Text="Manual"/>
            </StackPanel>
          </RadioButton>
          <RadioButton Tag="Settings" AutomationProperties.Name="Settings" GroupName="Navigation" Checked="Navigate" Style="{StaticResource NavigationItem}">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons" Text="" FontSize="20" Width="24" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <TextBlock Text="Settings"/>
            </StackPanel>
          </RadioButton>
        </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <Grid x:Name="ContentPanel" Grid.Column="1" Margin="28,24,28,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel x:Name="HeadingPanel" Margin="0,0,0,20">
        <TextBlock x:Name="PageTitle" Text="Home" FontSize="28" FontWeight="SemiBold"/>
      </StackPanel>
      <ScrollViewer x:Name="HomePage" Grid.Row="1" Visibility="Visible" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
          <Border x:Name="NowPlayingCard" Style="{StaticResource Card}" Background="{DynamicResource HeroBrush}" Margin="0,0,0,12" Padding="0">
            <Grid ClipToBounds="True" SizeChanged="HeroSurfaceSizeChanged">
              <Grid x:Name="HeroArtworkLayer" IsHitTestVisible="False" ClipToBounds="True">
                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=ArtworkTintBox}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Source, ElementName=ArtImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Border Margin="-32" Opacity="0.48" CacheMode="BitmapCache">
                  <Border.Background><ImageBrush ImageSource="{Binding Source, ElementName=ArtImage}" Stretch="UniformToFill" AlignmentY="Center"/></Border.Background>
                  <Border.Effect><BlurEffect Radius="28" RenderingBias="Performance"/></Border.Effect>
                </Border>
                <Border Background="{DynamicResource SurfaceBrush}" Opacity="0.5"/>
                <Border Background="{DynamicResource SurfaceBrush}"><Border.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF000000" Offset="0"/><GradientStop Color="#E6000000" Offset="0.30"/><GradientStop Color="#44000000" Offset="0.68"/><GradientStop Color="#10000000" Offset="1"/></LinearGradientBrush></Border.OpacityMask></Border>
              </Grid>
            <Grid x:Name="HeroGrid" Margin="22">
              <Grid.ColumnDefinitions><ColumnDefinition x:Name="ArtworkColumn" Width="216"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border x:Name="ArtworkFrame" Width="194" Height="194" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource AccentMutedBrush}">
                <Grid><Grid.OpacityMask><VisualBrush><VisualBrush.Visual><Border Width="194" Height="194" CornerRadius="10" Background="White"/></VisualBrush.Visual></VisualBrush></Grid.OpacityMask>
                  <Image x:Name="ArtImage" Stretch="UniformToFill" AutomationProperties.Name="Apple Music album artwork"/>
                  <TextBlock x:Name="ArtFallback" Text="♫" FontSize="56" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel LastChildFill="False" Margin="0,0,0,12">
                  <TextBlock Text="NOW PLAYING" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                  <Border DockPanel.Dock="Right" Style="{StaticResource StatusPill}"><TextBlock x:Name="SourceText" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></Border>
                </DockPanel>
                <Grid x:Name="HeroContentGrid" Grid.Row="1">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel x:Name="TrackMetadata" Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TrackText" Text="No track playing" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" FontWeight="SemiBold" MaxHeight="76" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <TextBlock x:Name="ArtistText" FontSize="15" Foreground="{DynamicResource TextBrush}" Margin="0,5,0,0" MaxHeight="42" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="AlbumText" Style="{StaticResource Caption}" Margin="0,4,0,0" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                    <Border Style="{StaticResource StatusPill}" HorizontalAlignment="Left" Margin="0,10,0,0"><TextBlock x:Name="LyricsStatusText" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></Border>
                  </StackPanel>
                  <Border x:Name="HeroLyricPanel" Grid.Column="1" BorderThickness="0" Padding="22,4,0,4" VerticalAlignment="Center">
                    <StackPanel>
                      <TextBlock x:Name="LyricText" Text="—" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="27" FontWeight="Light" TextAlignment="Center" LineHeight="36" LineStackingStrategy="BlockLineHeight" MaxHeight="144" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                      <Border Width="22" Height="2" CornerRadius="1" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    </StackPanel>
                  </Border>
                </Grid>
                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                  <ProgressBar x:Name="PositionProgress" Maximum="1" Height="4" BorderThickness="0" Background="{DynamicResource LineBrush}" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="Playback progress"/>
                  <TextBlock x:Name="PositionText" Style="{StaticResource Caption}" Margin="0,7,0,0"/>
                </StackPanel>
              </Grid>
            </Grid>
            </Grid>
          </Border>
          <Grid x:Name="HomePreferencesGrid" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border x:Name="ProfilesCard" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,14"><Button Content="Manage" Click="ManageProfiles" DockPanel.Dock="Right" Style="{StaticResource SmallButton}"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8D6;" Margin="0,0,10,0"/><TextBlock Text="Profiles" Style="{StaticResource DashboardTitle}"/></StackPanel></DockPanel>
                <ListBox x:Name="ProfileCards" Grid.Row="1" SelectionChanged="SelectProfile" SelectedValuePath="Id" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Saved display profiles" VerticalAlignment="Center" Padding="0">
                  <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource PresetItem}"><Setter Property="Width" Value="102"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,0,8,4"/></Style></ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate><DataTemplate><StackPanel><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="6" HorizontalAlignment="Left" Margin="0,0,0,7"><TextBlock FontFamily="Segoe Fluent Icons" FontSize="16"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE8A4;"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Preset}" Value="Song + Lyrics"><Setter Property="Text" Value="&#xE8D6;"/></DataTrigger><DataTrigger Binding="{Binding Preset}" Value="Custom"><Setter Property="Text" Value="&#xE713;"/></DataTrigger><DataTrigger Binding="{Binding Preset}" Value="Status / Time"><Setter Property="Text" Value="&#xE916;"/></DataTrigger><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Preset}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
            <Border x:Name="ContextCard" Grid.Column="1" Style="{StaticResource Card}" Padding="18">
              <StackPanel>
                <TextBlock Text="Lyric context" Style="{StaticResource DashboardTitle}" Margin="0,0,0,14"/>
                <ListBox x:Name="ContextBox" SelectionChanged="ContextChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Lyric context mode" Padding="0">
                  <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource PresetItem}"><Setter Property="Padding" Value="7,7"/><Setter Property="Margin" Value="0,0,5,5"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style></ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="11" TextAlignment="Center"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="ContextHint" Text="The current lyric takes priority when space is limited." Visibility="Collapsed"/>
                <CheckBox x:Name="CompactBox" Content="Compact / Floating" FontSize="12" Margin="0,8,0,0" Checked="DisplayChanged" Unchecked="DisplayChanged" ToolTip="{Binding Text, ElementName=ContextHint}"/>
              </StackPanel>
            </Border>
          </Grid>
          <Grid x:Name="HomeDetailsGrid" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.38*"/><ColumnDefinition Width="1.12*"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ContentControl x:Name="HomePreviewHost" Margin="0,0,12,0" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"/>
            <Border x:Name="InspectorCard" Grid.Column="1" Style="{StaticResource Card}" Padding="18" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="Lyrics details" Style="{StaticResource DashboardTitle}" Margin="0,0,0,14"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="Source" Style="{StaticResource Caption}" Margin="0,0,12,4"/><TextBlock Grid.Row="0" Grid.Column="1" x:Name="InspectorSource" Text="—" FontSize="12" Margin="0,0,0,4" />
<TextBlock Grid.Row="1" Text="Cache" Style="{StaticResource Caption}" Margin="0,0,12,4"/><TextBlock Grid.Row="1" Grid.Column="1" x:Name="InspectorCache" Text="—" FontSize="12" Margin="0,0,0,4" />
<TextBlock Grid.Row="2" Text="Duration¹" Style="{StaticResource Caption}" Margin="0,0,12,4"/><TextBlock Grid.Row="2" Grid.Column="1" x:Name="InspectorDuration" Text="—" FontSize="12" Margin="0,0,0,4" />
<TextBlock Grid.Row="3" Text="Global offset" Style="{StaticResource Caption}" Margin="0,0,12,4"/><TextBlock Grid.Row="3" Grid.Column="1" x:Name="InspectorGlobalOffset" Text="—" FontSize="12" Margin="0,0,0,4" />
<TextBlock Grid.Row="4" Text="Saved offset" Style="{StaticResource Caption}" Margin="0,0,12,4"/><TextBlock Grid.Row="4" Grid.Column="1" x:Name="InspectorSavedOffset" Text="—" FontSize="12" Margin="0,0,0,4" />
<TextBlock Grid.Row="5" Text="Effective offset" Style="{StaticResource Caption}" Margin="0,0,12,4"/><TextBlock Grid.Row="5" Grid.Column="1" x:Name="InspectorEffectiveOffset" Text="—" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource AccentBrush}" />
</Grid>
                <TextBlock Text="¹ Apple Music / lyrics candidate" Style="{StaticResource Caption}" FontSize="10" Margin="0,0,0,10"/>
                <Expander Header="Recording &amp; timing" FontSize="12">
                  <StackPanel Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="Match" Style="{StaticResource Caption}" Margin="0,0,12,4"/><TextBlock Grid.Row="0" Grid.Column="1" x:Name="InspectorMatch" Text="—" FontSize="12" Margin="0,0,0,4" />
<TextBlock Grid.Row="1" Text="Manual match" Style="{StaticResource Caption}" Margin="0,0,12,4"/><TextBlock Grid.Row="1" Grid.Column="1" x:Name="InspectorManual" Text="—" FontSize="12" Margin="0,0,0,4" />
<TextBlock Grid.Row="2" Text="Ignored" Style="{StaticResource Caption}" Margin="0,0,12,4"/><TextBlock Grid.Row="2" Grid.Column="1" x:Name="InspectorIgnored" Text="—" FontSize="12" Margin="0,0,0,4" />
                </Grid>
                    <Button Content="Forget manual match" Click="ForgetMatch" IsEnabled="{Binding IsEnabled, ElementName=ForgetMatchButton}" Style="{StaticResource SmallButton}" Margin="0,2,0,12"/>
                    <DockPanel><TextBlock Text="Lyric timing" FontWeight="SemiBold"/><TextBlock x:Name="OffsetText" Text="0.0 s" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></DockPanel>
                    <Slider x:Name="OffsetSlider" ToolTip="Positive timing values show lyrics later." Minimum="-5" Maximum="5" TickFrequency="0.1" SmallChange="0.1" LargeChange="0.5" IsSnapToTickEnabled="True" ValueChanged="OffsetChanged" AutomationProperties.Name="Lyric offset in seconds" Margin="0,6,0,2" />

                    <TextBlock x:Name="CorrectionStatus" Style="{StaticResource Caption}" Margin="0,4,0,8"/>
                    <WrapPanel><Button x:Name="SaveSongButton" Content="Save for song" Click="SaveSongCorrection" Style="{StaticResource SmallButton}" Margin="0,0,6,6"/><Button x:Name="ResetSongButton" Content="Reset song" Click="ResetSongCorrection" Style="{StaticResource SmallButton}" Margin="0,0,0,6"/><Button Content="Use globally" Click="UseGlobalCorrection" Style="{StaticResource SmallButton}"/></WrapPanel>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
            <Border x:Name="QuickMessagesCard" Grid.Column="2" Style="{StaticResource Card}" Padding="18">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Quick messages" Style="{StaticResource DashboardTitle}"/>
                <TextBlock Grid.Row="1" Text="Choose a draft, then Send." Style="{StaticResource Caption}" Margin="0,6,0,16"/>
                <ScrollViewer Grid.Row="2" MaxHeight="128" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="HomeQuickMessages" ItemTemplate="{StaticResource DashboardQuickTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="QuickEmptyText" Grid.Row="3" Text="Add reusable messages in Manual." Style="{StaticResource Caption}" Visibility="Collapsed"/>
                <Button Grid.Row="4" Content="Edit messages" Click="ManageQuickMessages" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
              </Grid>
            </Border>
          </Grid>
          <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
              <TextBlock Text="Lyrics tools" Style="{StaticResource DashboardTitle}" Margin="0,8,24,8"/>
              <Button x:Name="InspectorSearchButton" Content="Search alternatives" Click="OpenMatches" Margin="0,0,8,0"/>
              <Button Content="Import LRC…" Click="ImportLrc" IsEnabled="{Binding IsEnabled, ElementName=ImportButton}" Margin="0,0,8,0"/>
              <Button x:Name="IgnoreButton" Content="Ignore this recording" Click="ToggleIgnore"/>
            </WrapPanel>
          </Border>
          <Border x:Name="RecoveryCard" Style="{StaticResource Card}" Margin="0,0,8,14" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="RecoveryTitle" Style="{StaticResource SectionTitle}" />
              <TextBlock x:Name="RecoveryHint" Style="{StaticResource Caption}" Margin="0,0,0,12" />
              <WrapPanel>
                <Button x:Name="RecoveryRetryButton" Content="Retry lyrics" Click="RetryLyrics" Margin="0,0,8,8" />
                <Button x:Name="ChooseMatchButton" Content="Search alternatives" Click="OpenMatches" Margin="0,0,8,8" />
                <Button x:Name="RecoveryImportButton" Content="Import LRC…" Click="ImportLrc" Margin="0,0,8,8" />
                <Button Content="{Binding Content, ElementName=IgnoreButton}" Click="ToggleIgnore" Margin="0,0,0,8" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border x:Name="MatchCard" Style="{StaticResource Card}" Margin="0,0,8,14" Visibility="{Binding Visibility, ElementName=MatchPanel}">
                  <StackPanel x:Name="MatchPanel" Visibility="Collapsed" Margin="0,12,0,0">
                    <TextBox x:Name="MatchQuery" MaxLength="512" AutomationProperties.Name="Search lyrics candidates" />
                    <WrapPanel Margin="0,8,0,8"><Button x:Name="SearchMatchesButton" Content="Search" Click="SearchMatches" Margin="0,0,8,4" /><Button x:Name="UseMatchButton" Content="Use selected match" Click="UseMatch" Margin="0,0,8,4" /><Button Content="Cancel" Click="CloseMatches" Margin="0,0,0,4" /></WrapPanel>
                    <TextBlock x:Name="MatchStatus" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                    <ListBox x:Name="MatchChoices" MaxHeight="220" Background="{DynamicResource RaisedBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Candidate recordings">
                      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" Margin="6" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
                      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.ItemContainerStyle>
                    </ListBox>
                  </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="DisplayPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,8,14">
            <StackPanel>
              <TextBlock Text="Saved profiles" Style="{StaticResource SectionTitle}"/>
              <ComboBox ItemsSource="{Binding ItemsSource, ElementName=ProfileCards}" SelectedValue="{Binding SelectedValue, ElementName=ProfileCards, Mode=TwoWay}" SelectedValuePath="Id" DisplayMemberPath="Name" AutomationProperties.Name="Selected profile"/>
              <Grid Margin="0,12,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="ProfileNameBox" MaxLength="40" AutomationProperties.Name="Profile name" Margin="0,0,8,0"/>
                <Button Content="Rename" Click="RenameProfile" Grid.Column="1"/>
              </Grid>
              <WrapPanel><Button Content="New profile" Click="NewProfile" Margin="0,0,8,8"/><Button Content="Duplicate" Click="DuplicateProfile" Margin="0,0,8,8"/><Button x:Name="DeleteProfileButton" Content="Delete profile" Click="DeleteProfile" Margin="0,0,0,8"/></WrapPanel>
              <TextBlock x:Name="ProfileStatus" Text="Changes save automatically. Appearance stays global." Style="{StaticResource Caption}"/>
              <TextBlock Text="Lyric context" Style="{StaticResource Caption}" Margin="0,16,0,6"/>
              <ComboBox ItemsSource="{Binding ItemsSource, ElementName=ContextBox}" SelectedItem="{Binding SelectedItem, ElementName=ContextBox, Mode=TwoWay}" AutomationProperties.Name="Profile lyric context"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,8,16">
            <StackPanel>
              <TextBlock Text="Profile layout" Style="{StaticResource SectionTitle}"/>
              <ListBox x:Name="PresetBox" SelectionChanged="DisplayChanged" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Display preset">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                  <StaticResource ResourceKey="PresetItem"/>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding}" FontWeight="SemiBold"/>
                      <TextBlock x:Name="Example" Style="{StaticResource Caption}" Margin="0,8,0,0" Text="Current lyric"/>
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding}" Value="Song + Lyrics">
                        <Setter TargetName="Example" Property="Text" Value="Song — Artist&#10;Current lyric"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding}" Value="Status / Time">
                        <Setter TargetName="Example" Property="Text" Value="Your status&#10;21:30"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding}" Value="Custom">
                        <Setter TargetName="Example" Property="Text" Value="Custom text and tokens"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="Choose a layout. The live preview below shows your actual output." Style="{StaticResource Caption}" Margin="0,6,0,12"/>
              <CheckBox Content="Floating text" IsChecked="{Binding IsChecked, ElementName=CompactBox, Mode=TwoWay}" Margin="0,0,0,12"/>
<StackPanel x:Name="StatusPanel">              <TextBlock Text="Status message" Style="{StaticResource SectionTitle}"/>
<WrapPanel Margin="0,0,0,8"><ComboBox x:Name="CustomAlignmentBox" Width="110" SelectionChanged="DisplayChanged" AutomationProperties.Name="Custom and status alignment" Margin="0,0,8,8"/><ComboBox x:Name="StatusAsciiBox" Width="150" DisplayMemberPath="Name" AutomationProperties.Name="Status ASCII template" Margin="0,0,8,8"/><Button Content="Insert ASCII" Tag="Status" Click="InsertAscii" Margin="0,0,0,8"/></WrapPanel>
              <TextBox x:Name="MessageBox" FontFamily="Consolas" MaxLength="512" AcceptsReturn="True" TextWrapping="Wrap" Height="76" TextChanged="DisplayChanged" AutomationProperties.Name="Custom status"/>
              <TextBlock Text="Saved locally. Used by Status / Time and the message token." Style="{StaticResource Caption}" Margin="0,6,0,12"/><TextBlock Text="Alignment applies to Status / Time and Custom. Spaces approximate 24–48 columns; VRChat spacing can differ." Style="{StaticResource Caption}"/></StackPanel>
            </StackPanel>
          </Border>
          <Border x:Name="CustomPanel" Style="{StaticResource Card}" Margin="0,0,8,16" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Custom composition" Style="{StaticResource SectionTitle}"/>
              <WrapPanel Margin="0,0,0,8"><ComboBox Width="110" ItemsSource="{Binding ItemsSource, ElementName=CustomAlignmentBox}" SelectedItem="{Binding SelectedItem, ElementName=CustomAlignmentBox, Mode=TwoWay}" AutomationProperties.Name="Custom template alignment" Margin="0,0,8,8"/><ComboBox x:Name="CustomAsciiBox" Width="150" DisplayMemberPath="Name" AutomationProperties.Name="Custom ASCII template" Margin="0,0,8,8"/><Button Content="Insert ASCII" Tag="Custom" Click="InsertAscii" Margin="0,0,0,8"/></WrapPanel>
              <TextBox x:Name="TemplateBox" FontFamily="Consolas" MaxLength="512" AcceptsReturn="True" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto" TextChanged="DisplayChanged" AutomationProperties.Name="Custom template"/>
              <TextBlock Text="{}{lyrics}  {title}  {artist}  {album}  {time}&#10;{message}  {elapsed}  {duration}" Style="{StaticResource Caption}" Margin="0,10,0,16"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="ManualPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,8,14">
            <StackPanel>
              <TextBlock Text="Quick messages" Style="{StaticResource SectionTitle}"/>
              <ItemsControl x:Name="ManualQuickMessages" ItemTemplate="{StaticResource QuickMessageTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
              <TextBlock Text="Select to prepare an unsent draft, including when Live edit is on." Style="{StaticResource Caption}" Margin="0,4,0,12"/>
              <Expander Header="Manage reusable messages">
                <StackPanel Margin="0,12,0,0">
                  <ComboBox x:Name="QuickEditBox" DisplayMemberPath="Name" SelectionChanged="EditQuickMessage" AutomationProperties.Name="Saved quick message"/>
                  <TextBlock Text="Name" Style="{StaticResource Caption}" Margin="0,10,0,6"/>
                  <TextBox x:Name="QuickNameBox" MaxLength="32" AutomationProperties.Name="Quick message name"/>
                  <TextBlock Text="Message" Style="{StaticResource Caption}" Margin="0,10,0,6"/>
                  <TextBox x:Name="QuickTextBox" FontFamily="Consolas" MaxLength="512" AcceptsReturn="True" TextWrapping="Wrap" Height="92" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Reusable message text"/>
                  <WrapPanel Margin="0,12,0,0"><Button Content="New" Click="NewQuickMessage" Margin="0,0,8,8"/><Button Content="Save message" Click="SaveQuickMessage" Margin="0,0,8,8"/><Button Content="Remove" Click="DeleteQuickMessage" Margin="0,0,0,8"/></WrapPanel>
                  <TextBlock x:Name="QuickStatus" Text="Saved only on this computer. This list is not chat history." Style="{StaticResource Caption}"/>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,8,16">
            <StackPanel>
              <DockPanel>
                <TextBlock Text="Manual message" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="ManualBudgetText" Text="0 characters" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
              </DockPanel>
              <TextBlock x:Name="ManualStateText" Text="Your draft takes priority over automatic lyrics." Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,16"/>
<WrapPanel Margin="0,0,0,8"><ComboBox x:Name="ManualAlignmentBox" Width="110" SelectionChanged="DisplayChanged" AutomationProperties.Name="Manual alignment" Margin="0,0,8,8"/><ComboBox x:Name="ManualAsciiBox" Width="150" DisplayMemberPath="Name" AutomationProperties.Name="Manual ASCII template" Margin="0,0,8,8"/><Button Content="Insert ASCII" Tag="Manual" Click="InsertAscii" Margin="0,0,0,8"/></WrapPanel>
<TextBox x:Name="DraftBox" FontFamily="Consolas" MaxLength="2048" AcceptsReturn="True" TextWrapping="Wrap" Height="144" VerticalScrollBarVisibility="Auto" TextChanged="DraftChanged" GotKeyboardFocus="DraftFocused" LostKeyboardFocus="DraftUnfocused" PreviewKeyDown="DraftKeyDown" AutomationProperties.Name="Manual message"/>
              <WrapPanel Margin="0,16,0,16">
                <Button x:Name="SendButton" Content="Send · Ctrl+Enter" Style="{StaticResource PrimaryButton}" Click="SendManual" Margin="0,0,8,8"/>
                <Button x:Name="ClearButton" Content="Clear" Click="ClearManual" Margin="0,0,8,8"/>
                <Button Content="Resume Automatic" Click="ResumeAutomatic" Margin="0,0,8,8"/>
              </WrapPanel>
              <CheckBox x:Name="TypingBox" Content="Show typing indicator" Checked="DisplayChanged" Unchecked="DisplayChanged" Margin="0,0,0,12"/>
              <CheckBox x:Name="LiveBox" Content="Live edit" Checked="LiveChanged" Unchecked="LiveChanged"/>
              <TextBlock Text="Alignment uses spaces and may differ in VRChat. ASCII spacing is preserved. Send holds the message for eight seconds; drafts are not saved." Style="{StaticResource Caption}" Margin="0,6,0,12"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,8,16">
            <StackPanel>
              <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Accent color" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
              <ComboBox x:Name="AccentBox" SelectionChanged="AppearanceChanged" AutomationProperties.Name="Accent color"/>
              <StackPanel x:Name="CustomAccentPanel" Visibility="Collapsed" Margin="0,12,0,0">
                <WrapPanel><TextBox x:Name="CustomColorBox" Width="130" MaxLength="7" TextChanged="CustomAccentChanged" AutomationProperties.Name="Custom accent hex color" Margin="0,0,8,6"/><Button Content="Choose color…" Click="ChooseAccentColor" Margin="0,0,0,6"/></WrapPanel>
              </StackPanel>
              <TextBlock Text="Background" Style="{StaticResource Caption}" Margin="0,16,0,6"/>
              <ComboBox x:Name="BackgroundBox" SelectionChanged="AppearanceChanged" AutomationProperties.Name="Background style"/>
              <CheckBox x:Name="ArtworkTintBox" Content="Tint Now Playing from album artwork" Checked="AppearanceChanged" Unchecked="AppearanceChanged" Margin="0,18,0,8"/>
              <TextBlock x:Name="AppearanceStatus" Style="{StaticResource Caption}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,8,16">
            <StackPanel>
              <TextBlock Text="Application behavior" Style="{StaticResource SectionTitle}"/>
              <CheckBox x:Name="StartWindowsBox" Content="Start with Windows" Checked="BehaviorChanged" Unchecked="BehaviorChanged" Margin="0,12,0,4"/>
              <TextBlock Text="Launch when you sign in. If you move a portable copy, enable this again from its new location." Style="{StaticResource Caption}"/>
              <CheckBox x:Name="StartMinimizedBox" Content="Start minimized" Checked="BehaviorChanged" Unchecked="BehaviorChanged" Margin="0,12,0,4"/>
              <TextBlock Text="Start without opening the main working view." Style="{StaticResource Caption}"/>
              <CheckBox x:Name="MinimizeTrayBox" Content="Minimize to system tray" Checked="BehaviorChanged" Unchecked="BehaviorChanged" Margin="0,12,0,4"/>
              <TextBlock Text="Hide in the notification area when minimized." Style="{StaticResource Caption}"/>
              <CheckBox x:Name="CloseTrayBox" Content="Close window to system tray" Checked="BehaviorChanged" Unchecked="BehaviorChanged" Margin="0,12,0,4"/>
              <TextBlock Text="Keep running when closed. Use Exit in the tray menu to quit." Style="{StaticResource Caption}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,8,16">
            <StackPanel>
              <TextBlock Text="Updates" Style="{StaticResource SectionTitle}"/>
              <TextBlock x:Name="UpdateStatus" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
              <WrapPanel><Button x:Name="CheckUpdatesButton" Content="Check now" Click="CheckUpdates" Margin="0,0,8,8"/><Button x:Name="ViewReleaseButton" Content="View release" Click="ViewRelease" Visibility="Collapsed" Margin="0,0,0,8"/></WrapPanel>
              <StackPanel x:Name="ReleaseDetails" Visibility="Collapsed" Margin="0,8,0,12">
                <TextBlock Text="What's new" Style="{StaticResource SectionTitle}"/>
                <TextBox x:Name="UpdateNotes" IsReadOnly="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="200" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Release notes"/>
                <WrapPanel Margin="0,12,0,8">
                  <Button x:Name="DownloadInstallerButton" Content="Download verified installer" Click="DownloadInstaller" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                  <Button x:Name="SkipUpdateButton" Content="Skip this version" Click="SkipUpdate" Margin="0,0,8,8"/>
                  <Button x:Name="CancelDownloadButton" Content="Cancel download" Click="CancelInstallerDownload" Visibility="Collapsed" Margin="0,0,0,8"/>
                </WrapPanel>
                <ProgressBar x:Name="DownloadProgress" Maximum="100" Height="4" Visibility="Collapsed" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource RaisedBrush}"/>
              </StackPanel>
              <TextBlock x:Name="DownloadStatus" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
              <Button x:Name="LaunchInstallerButton" Content="Open verified installer…" Click="LaunchInstaller" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,12"/>
              <CheckBox x:Name="AutoUpdateBox" Content="Check for updates at startup" Checked="AutomaticUpdatesChanged" Unchecked="AutomaticUpdatesChanged" Margin="0,8,0,8"/>
              <TextBlock Text="Checks GitHub only when requested or enabled here. Updates are never downloaded or installed automatically." Style="{StaticResource Caption}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,8,16">
            <StackPanel>
              <TextBlock Text="Lyrics sources" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Local LRC → cache → LRCLIB → NetEase" Foreground="{DynamicResource AccentBrush}"/>
              <TextBlock Text="NetEase is a best-effort fallback, searched only when LRCLIB cannot supply synchronized lyrics. No account or key is needed." Style="{StaticResource Caption}" Margin="0,6,0,12"/>
              <WrapPanel>
                <Button x:Name="ImportButton" Content="Import local LRC…" Click="ImportLrc" Margin="0,0,8,8"/>
                <Button Content="Open data folder" Click="OpenData" Margin="0,0,8,8"/>
                <Button Content="Retry lyrics" Click="RetryLyrics" Margin="0,0,8,8"/>
                <Button x:Name="ForgetMatchButton" Content="Forget manual match" Click="ForgetMatch" IsEnabled="False" Margin="0,0,8,8"/>
              </WrapPanel>
              <TextBlock Text="Searches send song metadata to the lyrics source. Settings and cached lyrics stay on this computer. Community endpoints may change or be unavailable in some regions." Style="{StaticResource Caption}" Margin="0,6,0,12"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,8,16">
            <StackPanel>
              <TextBlock Text="Diagnostics" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Current playback, provider and output state. No lyrics or chat messages. Review before sharing." Style="{StaticResource Caption}" Margin="0,0,0,12"/>
              <WrapPanel><Button Content="Copy diagnostics" Click="CopyDiagnostics" Margin="0,0,8,8"/><Button Content="Export diagnostics…" Click="ExportDiagnostics" Margin="0,0,0,8"/></WrapPanel>
              <TextBlock x:Name="DiagnosticsStatus" Style="{StaticResource Caption}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,8,16">
            <StackPanel>
              <TextBlock Text="VRChat OSC" Style="{StaticResource SectionTitle}"/>
              <TextBlock x:Name="DiscoveryStatus" Text="Manual destination" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
              <TextBlock x:Name="OscDestinationText" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <CheckBox x:Name="AutoOscBox" Content="Discover local VRChat with OSCQuery" Checked="DiscoveryModeChanged" Unchecked="DiscoveryModeChanged" Margin="0,0,0,10"/>
              <Button x:Name="DiscoverButton" Content="Find destination now" Click="DiscoverNow" HorizontalAlignment="Left" Margin="0,0,0,8"/>
              <TextBlock Text="Enable OSC in VRChat and stop competing Chatbox senders. UDP cannot confirm that a message was displayed." Style="{StaticResource Caption}" Margin="0,6,0,12"/>
              <Expander Header="Advanced destination">
                <Grid Margin="0,16,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Host" Style="{StaticResource Caption}" Margin="0,6,0,12"/>
                    <TextBox x:Name="HostBox" AutomationProperties.Name="OSC host"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Port" Style="{StaticResource Caption}" Margin="0,6,0,12"/>
                    <TextBox x:Name="PortBox" AutomationProperties.Name="OSC port"/>
                  </StackPanel>
                  <Button Grid.Column="2" Content="Apply" Click="ApplyOsc" VerticalAlignment="Bottom"/>
                </Grid>
              </Expander>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ContentControl x:Name="PersistentPreviewHost" Grid.Row="2" HorizontalContentAlignment="Stretch">
        <Border x:Name="PreviewCard" Style="{StaticResource Card}" Padding="18">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel x:Name="PreviewHeading" Margin="0,0,0,12"><TextBlock x:Name="BudgetText" Text="0 / 144" Style="{StaticResource Caption}" DockPanel.Dock="Right"/><TextBlock x:Name="PreviewLabel" Text="Chatbox preview" FontWeight="SemiBold" FontSize="14"/></DockPanel>
            <TextBlock x:Name="PreviewProfileText" Grid.Row="1" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
            <Border x:Name="PreviewFrame" Grid.Row="2" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,0" Background="Transparent" CornerRadius="5" Padding="12,8" Margin="0,0,0,12">
              <Border x:Name="PreviewBubble" Padding="0,4" VerticalAlignment="Center"><ScrollViewer x:Name="PreviewScroller" MaxHeight="130" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="PreviewText" Text="Nothing to send yet" FontSize="20" FontWeight="Light"/></ScrollViewer></Border>
            </Border>
            <StackPanel x:Name="PreviewStatus" Grid.Row="3"><TextBlock x:Name="OwnerText" Text="Automatic" Foreground="{DynamicResource AccentBrush}" FontSize="11"/><TextBlock x:Name="OscText" Text="OSC ready" Style="{StaticResource Caption}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
          </Grid>
        </Border>
      </ContentControl>
      <TextBlock Grid.Row="3" x:Name="ErrorText" Foreground="{DynamicResource WarningBrush}" Margin="0,8,0,0"/>
    </Grid>
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0">
      <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="MinimizeWindow" AutomationProperties.Name="Minimize" ToolTip="Minimize"/>
      <Button x:Name="MaximizeCaptionButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="ToggleMaximizeWindow" AutomationProperties.Name="Maximize or restore" ToolTip="Maximize or restore"/>
      <Button Content="&#xE8BB;" Style="{StaticResource CaptionButton}" Click="CloseWindow" AutomationProperties.Name="Close" ToolTip="Close"/>
    </StackPanel>
  </Grid>
</Window>
