                <Grid.ColumnDefinitions><ColumnDefinition x:Name="ArtworkColumn" Width="236"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <Border x:Name="ArtworkFrame" Grid.RowSpan="2" Width="208" Height="208" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource AccentMutedBrush}">
                  <Grid><Grid.OpacityMask><VisualBrush><VisualBrush.Visual><Border Width="208" Height="208" CornerRadius="10" Background="White"/></VisualBrush.Visual></VisualBrush></Grid.OpacityMask>
                    <Image x:Name="ArtImage" Stretch="UniformToFill" AutomationProperties.Name="Album artwork"/>
                    <TextBlock x:Name="ArtFallback" Text="♫" FontSize="60" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <StackPanel x:Name="TrackMetadata" Grid.Column="1">
