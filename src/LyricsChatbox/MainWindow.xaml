                <TextBox x:Name="ProfileNameBox" MaxLength="40" AutomationProperties.Name="Profile name" Margin="0,0,8,0"/>
                <Button Content="Rename" Click="RenameProfile" Grid.Column="1"/>
              </Grid>
              <WrapPanel><Button Content="New profile" Click="NewProfile" Margin="0,0,8,8"/><Button Content="Duplicate" Click="DuplicateProfile" Margin="0,0,8,8"/><Button x:Name="DeleteProfileButton" Content="Delete profile" Click="DeleteProfile" Margin="0,0,0,8"/></WrapPanel>
              <TextBlock x:Name="ProfileStatus" Text="Changes save automatically. Appearance stays global." Style="{StaticResource Caption}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,8,16">
            <StackPanel>
              <TextBlock Text="Composition" Style="{StaticResource SectionTitle}"/>
              <ListBox x:Name="PresetBox" SelectionChanged="DisplayChanged" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Display preset">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                  <StaticResource ResourceKey="PresetItem"/>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding}" FontWeight="SemiBold"/>
                      <TextBlock x:Name="Example" Style="{StaticResource Caption}" Margin="0,8,0,0" Text="Current lyric"/>
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding}" Value="Song + Lyrics">
                        <Setter TargetName="Example" Property="Text" Value="Song — Artist&#10;Current lyric"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding}" Value="Status / Time">
                        <Setter TargetName="Example" Property="Text" Value="Your status&#10;21:30"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding}" Value="Custom">
                        <Setter TargetName="Example" Property="Text" Value="Custom text and tokens"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="Choose a layout. The live preview below shows your actual output." Style="{StaticResource Caption}" Margin="0,6,0,12"/>
              <StackPanel x:Name="CustomPanel" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="0,4,0,8"><TextBlock Text="Custom composition" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/><Button Content="Decorations menu" Tag="Custom" Click="OpenDecorationPicker" Style="{StaticResource SmallButton}" AutomationProperties.Name="Open decorations menu" ToolTip="Add symbols, kaomoji, text art and more"/></StackPanel>
                <TextBox x:Name="TemplateBox" FontFamily="Consolas" MaxLength="512" AcceptsReturn="True" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto" TextChanged="DisplayChanged" AutomationProperties.Name="Custom template"/>
                <ItemsControl x:Name="TokenChips" Margin="0,10,0,4">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Token}" Tag="{Binding Token}" Click="InsertCompositionToken" Style="{StaticResource SmallButton}" Margin="0,0,6,6" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Description}"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="CustomMessageHint" Text="Add {message} to include status or rotating messages." Style="{StaticResource Caption}" Visibility="Collapsed"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border x:Name="StatusPanel" Style="{StaticResource Card}" Margin="0,0,8,16" Visibility="Collapsed">
            <StackPanel>
              <DockPanel><TextBlock x:Name="RotationCountText" Text="0 / 16 messages" Style="{StaticResource Caption}" DockPanel.Dock="Right"/><TextBlock Text="Status messages" Style="{StaticResource SectionTitle}"/></DockPanel>
              <CheckBox x:Name="RotationEnabledBox" Content="Rotate messages" Checked="RotationEnabledChanged" Unchecked="RotationEnabledChanged" Margin="0,0,0,10"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="Change every" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="RotationIntervalBox" Width="130" SelectionChanged="RotationIntervalChanged" AutomationProperties.Name="Message rotation interval"/></StackPanel>
              <ListBox x:Name="RotationList" SelectionChanged="RotationSelectionChanged" MaxHeight="180" Margin="0,0,0,10" Padding="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Status messages">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource PresetItem}"><Setter Property="Padding" Value="8,7"/><Setter Property="Margin" Value="0,0,0,6"/></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="2,3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Click="RotationItemEnabledChanged" VerticalAlignment="Center" Margin="0,0,8,0" AutomationProperties.Name="Enable status message"/>
                      <TextBlock Grid.Column="1" Text="{Binding Preview}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      <Button Grid.Column="2" Content="↑" Tag="Up" Click="MoveRotationMessage" IsEnabled="{Binding CanMoveUp}" Style="{StaticResource SmallButton}" Margin="8,0,4,0" ToolTip="Move up" AutomationProperties.Name="Move message up"/>
                      <Button Grid.Column="3" Content="↓" Tag="Down" Click="MoveRotationMessage" IsEnabled="{Binding CanMoveDown}" Style="{StaticResource SmallButton}" ToolTip="Move down" AutomationProperties.Name="Move message down"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button x:Name="AddRotationMessageButton" Content="+ Add message" Click="AddRotationMessage" HorizontalAlignment="Left" Margin="0,0,0,8"/>
              <TextBlock x:Name="RotationRuntimeText" Text="Rotation off" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
              <StackPanel x:Name="RotationEditorPanel" Visibility="Collapsed">
                <TextBlock x:Name="RotationEditorTitle" Text="Selected message" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="RotationMessageBox" FontFamily="Consolas" MaxLength="512" AcceptsReturn="True" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Status message text"/>
                <WrapPanel x:Name="RotationEditorActions" Margin="0,10,0,4"><Button Content="Decorations menu" Tag="Rotation" Click="OpenDecorationPicker" Margin="0,0,8,8" AutomationProperties.Name="Open decorations menu" ToolTip="Add symbols, kaomoji, text art and more"/><Button Content="Save" Click="SaveRotationMessage" Margin="0,0,8,8"/><Button x:Name="RemoveRotationMessageButton" Content="Remove" Click="RemoveRotationMessage" Margin="0,0,0,8"/></WrapPanel>
                <Border x:Name="RotationRemoveConfirmation" Visibility="Collapsed" Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,4">
                  <StackPanel><TextBlock Text="Remove this message?" FontWeight="SemiBold" Margin="0,0,0,10"/><WrapPanel><Button Content="Cancel" Click="CancelRotationMessageRemoval" Margin="0,0,8,0" AutomationProperties.Name="Cancel removal"/><Button Content="Remove message" Click="ConfirmRemoveRotationMessage" Foreground="{DynamicResource WarningBrush}" AutomationProperties.Name="Confirm remove message"/></WrapPanel></StackPanel>
                </Border>
                <TextBlock x:Name="RotationEditStatus" Style="{StaticResource Caption}"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border x:Name="LyricContextPanel" Style="{StaticResource Card}" Margin="0,0,8,16">
            <StackPanel><TextBlock Text="Lyric Context" Style="{StaticResource SectionTitle}"/><ComboBox x:Name="ProfileContextBox" ItemsSource="{Binding ItemsSource, ElementName=ContextBox}" SelectedItem="{Binding SelectedItem, ElementName=ContextBox, Mode=TwoWay}" AutomationProperties.Name="Profile lyric context"/><TextBlock x:Name="ProfileContextHint" Text="Nearby lyrics are included only when they fit; the current lyric always stays." Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,0,8,16">
            <StackPanel>
              <TextBlock Text="Presentation" Style="{StaticResource SectionTitle}"/>
              <CheckBox x:Name="CompactBox" Content="Floating text" Checked="DisplayChanged" Unchecked="DisplayChanged" Margin="0,0,0,10" ToolTip="Uses VRChat's compact floating style."/>
              <StackPanel x:Name="AlignmentPanel"><TextBlock Text="Alignment" Style="{StaticResource Caption}" Margin="0,0,0,6"/><ComboBox x:Name="CustomAlignmentBox" Width="120" HorizontalAlignment="Left" SelectionChanged="DisplayChanged" AutomationProperties.Name="Custom and status alignment"/><TextBlock Text="Center and Right use ordinary spaces and are approximate in VRChat." Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="ManualPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,8,14">
            <StackPanel>
              <TextBlock Text="Quick messages" Style="{StaticResource SectionTitle}"/>
              <ItemsControl x:Name="ManualQuickMessages" ItemTemplate="{StaticResource QuickMessageTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
              <TextBlock Text="Select to prepare an unsent draft, including when Live edit is on." Style="{StaticResource Caption}" Margin="0,4,0,12"/>
              <Expander Header="Manage reusable messages">
                <StackPanel Margin="0,12,0,0">
                  <ComboBox x:Name="QuickEditBox" DisplayMemberPath="Name" SelectionChanged="EditQuickMessage" AutomationProperties.Name="Saved quick message"/>
                  <TextBlock Text="Name" Style="{StaticResource Caption}" Margin="0,10,0,6"/>
                  <TextBox x:Name="QuickNameBox" MaxLength="32" AutomationProperties.Name="Quick message name"/>
                  <TextBlock Text="Message" Style="{StaticResource Caption}" Margin="0,10,0,6"/>
                  <TextBox x:Name="QuickTextBox" FontFamily="Consolas" MaxLength="512" AcceptsReturn="True" TextWrapping="Wrap" Height="92" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Reusable message text"/>
                  <WrapPanel Margin="0,12,0,0"><Button Content="New" Click="NewQuickMessage" Margin="0,0,8,8"/><Button Content="Save message" Click="SaveQuickMessage" Margin="0,0,8,8"/><Button Content="Remove" Click="DeleteQuickMessage" Margin="0,0,0,8"/></WrapPanel>
                  <TextBlock x:Name="QuickStatus" Text="Saved only on this computer. This list is not chat history." Style="{StaticResource Caption}"/>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,8,16">
            <StackPanel>
              <DockPanel>
                <TextBlock Text="Manual message" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="ManualBudgetText" Text="0 characters" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
              </DockPanel>
              <TextBlock x:Name="ManualStateText" Text="Your draft takes priority over automatic lyrics." Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,16"/>
<WrapPanel Margin="0,0,0,8"><ComboBox x:Name="ManualAlignmentBox" Width="110" SelectionChanged="DisplayChanged" AutomationProperties.Name="Manual alignment" Margin="0,0,8,8"/><Button Content="Decorations menu" Tag="Manual" Click="OpenDecorationPicker" Margin="0,0,0,8" AutomationProperties.Name="Open decorations menu" ToolTip="Add symbols, kaomoji, text art and more"/></WrapPanel>
<TextBox x:Name="DraftBox" FontFamily="Consolas" MaxLength="2048" AcceptsReturn="True" TextWrapping="Wrap" Height="144" VerticalScrollBarVisibility="Auto" TextChanged="DraftChanged" GotKeyboardFocus="DraftFocused" LostKeyboardFocus="DraftUnfocused" PreviewKeyDown="DraftKeyDown" AutomationProperties.Name="Manual message"/>
              <WrapPanel Margin="0,16,0,16">
                <Button x:Name="SendButton" Content="Send · Ctrl+Enter" Style="{StaticResource PrimaryButton}" Click="SendManual" Margin="0,0,8,8"/>
                <Button x:Name="ClearButton" Content="Clear" Click="ClearManual" Margin="0,0,8,8"/>
                <Button Content="Resume Automatic" Click="ResumeAutomatic" Margin="0,0,8,8"/>
              </WrapPanel>
              <CheckBox x:Name="TypingBox" Content="Show typing indicator" Checked="DisplayChanged" Unchecked="DisplayChanged" Margin="0,0,0,12"/>
              <CheckBox x:Name="LiveBox" Content="Live edit" Checked="LiveChanged" Unchecked="LiveChanged"/>
              <TextBlock Text="Alignment uses spaces and may differ in VRChat. Decoration spacing is preserved. Send holds the message for eight seconds; drafts are not saved." Style="{StaticResource Caption}" Margin="0,6,0,12"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,8,16">
            <StackPanel>
              <TextBlock Text="Playback source" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Choose which music app LyricsChatbox follows." Style="{StaticResource Caption}" Margin="0,0,0,10"/>
              <ComboBox x:Name="PlaybackSourceBox" SelectionChanged="PlaybackSourceChanged" AutomationProperties.Name="Playback source" MinWidth="180" HorizontalAlignment="Left"/>
              <TextBlock Text="Automatic follows the only playing app. If both play, choose one here." Style="{StaticResource Caption}" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,8,16">
            <StackPanel>
              <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Accent color" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
              <ComboBox x:Name="AccentBox" SelectionChanged="AppearanceChanged" AutomationProperties.Name="Accent color"/>
              <StackPanel x:Name="CustomAccentPanel" Visibility="Collapsed" Margin="0,12,0,0">
                <WrapPanel><TextBox x:Name="CustomColorBox" Width="130" MaxLength="7" TextChanged="CustomAccentChanged" AutomationProperties.Name="Custom accent hex color" Margin="0,0,8,6"/><Button Content="Choose color…" Click="ChooseAccentColor" Margin="0,0,0,6"/></WrapPanel>
              </StackPanel>
              <TextBlock Text="Background" Style="{StaticResource Caption}" Margin="0,16,0,6"/>
              <ComboBox x:Name="BackgroundBox" SelectionChanged="AppearanceChanged" AutomationProperties.Name="Background style"/>
