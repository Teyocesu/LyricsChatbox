            <ListBox.Template><ControlTemplate TargetType="ListBox"><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"><ItemsPresenter/></Border></ControlTemplate></ListBox.Template>
            <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBoxItem Content="Preview"/><ListBoxItem Content="Profiles"/><ListBoxItem Content="Context"/><ListBoxItem Content="Details"/><ListBoxItem Content="Tools"/>
          </ListBox>
          <ScrollViewer x:Name="HomeSectionsScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" AutomationProperties.Name="Home sections">
            <StackPanel x:Name="HomeColumns" TextElement.FontSize="14">
              <ContentControl x:Name="HomePreviewHost" Focusable="False" HorizontalContentAlignment="Stretch"/>
              <Border Style="{StaticResource PanelSeparator}"/>
              <StackPanel x:Name="ProfilesSection">
                <DockPanel Margin="0,0,0,8"><Button Content="Manage" Click="ManageProfiles" DockPanel.Dock="Right" Style="{StaticResource HomeHeaderAction}" AutomationProperties.Name="Manage profiles"/><TextBlock Text="Profiles" Style="{StaticResource InspectorHeading}"/></DockPanel>
                <ListBox x:Name="ProfileCards" SelectionChanged="SelectProfile" SelectedValuePath="Id" ItemContainerStyle="{StaticResource ProfileChoiceItem}" AutomationProperties.Name="Saved display profiles">
                  <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
                  <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Preset}" Style="{StaticResource HomeChoiceDetail}" Margin="12,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
              <Border Style="{StaticResource PanelSeparator}"/>
              <StackPanel x:Name="ContextCard">
                <TextBlock Text="Lyric context" Style="{StaticResource InspectorHeading}" Margin="0,0,0,8"/>
