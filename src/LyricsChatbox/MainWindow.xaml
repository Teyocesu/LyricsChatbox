                  <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
                  <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="ContextHint" Text="Adds nearby lyrics when they fit. The current lyric always stays." Style="{StaticResource InspectorCaption}" Margin="0,2,0,0" Visibility="Collapsed"/>
              </StackPanel>
              <Border Style="{StaticResource PanelSeparator}"/>
              <StackPanel x:Name="InspectorSection">
                <TextBlock Text="Lyrics details" Style="{StaticResource InspectorHeading}" Margin="0,0,0,8"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="168"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Text="Source" Style="{StaticResource HomeDetailLabel}"/><TextBlock x:Name="InspectorSource" Grid.Column="1" Text="—" Style="{StaticResource HomeDetailValue}"/>
                  <TextBlock Grid.Row="1" Text="Cache" Style="{StaticResource HomeDetailLabel}"/><TextBlock x:Name="InspectorCache" Grid.Row="1" Grid.Column="1" Text="—" Style="{StaticResource HomeDetailValue}"/>
                  <TextBlock Grid.Row="2" Text="{x:Static local:PresentationText.TrackLyricsDurationLabel}" Style="{StaticResource HomeDetailLabel}"/><TextBlock x:Name="InspectorDuration" Grid.Row="2" Grid.Column="1" Text="—" Style="{StaticResource HomeDetailValue}"/>
                  <TextBlock Grid.Row="3" Text="Global offset" Style="{StaticResource HomeDetailLabel}"/><TextBlock x:Name="InspectorGlobalOffset" Grid.Row="3" Grid.Column="1" Text="—" Style="{StaticResource HomeDetailValue}"/>
                  <TextBlock Grid.Row="4" Text="Saved offset" Style="{StaticResource HomeDetailLabel}"/><TextBlock x:Name="InspectorSavedOffset" Grid.Row="4" Grid.Column="1" Text="—" Style="{StaticResource HomeDetailValue}"/>
                  <TextBlock Grid.Row="5" Text="Effective offset" Style="{StaticResource HomeDetailLabel}"/><TextBlock x:Name="InspectorEffectiveOffset" Grid.Row="5" Grid.Column="1" Text="—" Style="{StaticResource HomeDetailValue}" Foreground="{DynamicResource AccentTextBrush}"/>
                </Grid>
                <Expander Header="Recording &amp; timing" Margin="0,8,0,0">
                  <StackPanel Margin="0,8,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="168"/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <TextBlock Text="Match" Style="{StaticResource HomeDetailLabel}"/><TextBlock x:Name="InspectorMatch" Grid.Column="1" Text="—" Style="{StaticResource HomeDetailValue}"/>
                      <TextBlock Grid.Row="1" Text="Manual match" Style="{StaticResource HomeDetailLabel}"/><TextBlock x:Name="InspectorManual" Grid.Row="1" Grid.Column="1" Text="—" Style="{StaticResource HomeDetailValue}"/>
                      <TextBlock Grid.Row="2" Text="Ignored" Style="{StaticResource HomeDetailLabel}"/><TextBlock x:Name="InspectorIgnored" Grid.Row="2" Grid.Column="1" Text="—" Style="{StaticResource HomeDetailValue}"/>
                    </Grid>
                    <Button Content="Forget manual match" Click="ForgetMatch" IsEnabled="{Binding IsEnabled, ElementName=ForgetMatchButton}" Style="{StaticResource InspectorButton}" HorizontalAlignment="Left" Margin="0,8,0,12"/>
                    <DockPanel><TextBlock x:Name="OffsetText" Text="0.0 s" DockPanel.Dock="Right" Foreground="{DynamicResource AccentTextBrush}"/><TextBlock Text="Lyric timing" FontWeight="SemiBold"/></DockPanel>
                    <Slider x:Name="OffsetSlider" ToolTip="Positive timing values show lyrics later." Minimum="-5" Maximum="5" TickFrequency="0.1" SmallChange="0.1" LargeChange="0.5" IsSnapToTickEnabled="True" ValueChanged="OffsetChanged" AutomationProperties.Name="Lyric offset in seconds" Margin="0,6,0,2"/>
                    <TextBlock x:Name="CorrectionStatus" Style="{StaticResource InspectorCaption}" Margin="0,4,0,8"/>
                    <WrapPanel><Button x:Name="SaveSongButton" Content="Save for song" Click="SaveSongCorrection" Style="{StaticResource InspectorButton}" Margin="0,0,6,6"/><Button x:Name="ResetSongButton" Content="Reset song" Click="ResetSongCorrection" Style="{StaticResource InspectorButton}" Margin="0,0,6,6"/><Button Content="Use globally" Click="UseGlobalCorrection" Style="{StaticResource InspectorButton}" Margin="0,0,0,6"/></WrapPanel>
                  </StackPanel>
                </Expander>
              </StackPanel>
              <Border Style="{StaticResource PanelSeparator}"/>
              <StackPanel x:Name="HomeToolsSection">
                <TextBlock Text="Lyrics tools" Style="{StaticResource InspectorHeading}" Margin="0,0,0,8"/>
                <StackPanel x:Name="RecoveryCard" Visibility="Collapsed" Margin="0,0,0,10">
                  <TextBlock x:Name="RecoveryTitle" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,2"/>
                  <TextBlock x:Name="RecoveryHint" Style="{StaticResource InspectorCaption}"/>
                </StackPanel>
                <WrapPanel>
                  <Button x:Name="HomeRetryButton" Content="Retry lyrics" Click="RetryLyrics" Style="{StaticResource InspectorButton}" Margin="0,0,8,6" Visibility="Collapsed"/>
                  <Button x:Name="InspectorSearchButton" Content="Search alternatives" Click="OpenMatches" Style="{StaticResource InspectorButton}" Margin="0,0,8,6"/>
                  <Button x:Name="HomeImportButton" Content="Import LRC…" Click="ImportLrc" IsEnabled="{Binding IsEnabled, ElementName=ImportButton}" Style="{StaticResource InspectorButton}" Margin="0,0,8,6"/>
                  <Button x:Name="IgnoreButton" Content="Ignore this recording" Click="ToggleIgnore" Style="{StaticResource InspectorButton}" Margin="0,0,0,6"/>
                </WrapPanel>
                <StackPanel x:Name="MatchPanel" Visibility="Collapsed" Margin="0,8,0,0">
                  <TextBox x:Name="MatchQuery" MaxLength="512" AutomationProperties.Name="Search lyrics candidates"/>
                  <WrapPanel Margin="0,8,0,8"><Button x:Name="SearchMatchesButton" Content="Search" Click="SearchMatches" Style="{StaticResource InspectorButton}" Margin="0,0,8,4"/><Button x:Name="UseMatchButton" Content="Use selected match" Click="UseMatch" Style="{StaticResource InspectorButton}" Margin="0,0,8,4"/><Button Content="Cancel" Click="CloseMatches" Style="{StaticResource InspectorButton}" Margin="0,0,0,4"/></WrapPanel>
                  <TextBlock x:Name="MatchStatus" Style="{StaticResource InspectorCaption}" Margin="0,0,0,8"/>
                  <ListBox x:Name="MatchChoices" MaxHeight="220" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Candidate recordings">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" Margin="6" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                  </ListBox>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
      <ScrollViewer x:Name="DisplayPage" Grid.RowSpan="3" Visibility="Collapsed" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
        <Grid x:Name="DisplayCanvas">
          <Grid.ColumnDefinitions><ColumnDefinition x:Name="DisplayProfilesColumn" Width="260"/><ColumnDefinition/><ColumnDefinition x:Name="DisplaySupportWidth" Width="320"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition x:Name="DisplayFirstRow"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border x:Name="DisplayProfilesPanel" BorderBrush="{DynamicResource LineBrush}">
            <local:ColumnScrollViewer x:Name="DisplayProfilesScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
              <StackPanel x:Name="DisplayProfilesContent" TextElement.FontSize="14">
                <TextBlock Text="Profile" Style="{StaticResource InspectorHeading}" Margin="0,0,0,8"/>
                <ListBox ItemsSource="{Binding ItemsSource, ElementName=ProfileCards}" SelectedValue="{Binding SelectedValue, ElementName=ProfileCards, Mode=TwoWay}" SelectedValuePath="Id" ItemContainerStyle="{StaticResource ProfileChoiceItem}" AutomationProperties.Name="Selected profile">
                  <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
                  <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Grid Margin="0,10,0,8">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="ProfileNameBox" MaxLength="40" AutomationProperties.Name="Profile name" Margin="0,0,8,0"/>
                  <Button Content="Rename" Click="RenameProfile" Grid.Column="1"/>
                </Grid>
                <WrapPanel>
                  <Button Content="New profile" Click="NewProfile" Margin="0,0,8,8"/>
                  <Button Content="Duplicate" Click="DuplicateProfile" Margin="0,0,8,8"/>
                  <Button x:Name="DeleteProfileButton" Content="Delete profile" Click="DeleteProfile" Margin="0,0,0,8"/>
                </WrapPanel>
                <TextBlock x:Name="ProfileStatus" Text="Changes save automatically. Appearance stays global." Style="{StaticResource InspectorCaption}"/>
                <Border Style="{StaticResource PanelSeparator}" Margin="-20,16"/>
                <TextBlock Text="Composition" Style="{StaticResource InspectorHeading}" Margin="0,0,0,8"/>
                <ListBox x:Name="PresetBox" SelectionChanged="DisplayChanged" ItemContainerStyle="{StaticResource HomeChoiceItem}" AutomationProperties.Name="Display preset">
                  <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
                  <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock Text="{Binding}"/>
                        <TextBlock x:Name="Example" Style="{StaticResource HomeChoiceDetail}" FontSize="12" Margin="0,2,0,0" Text="Current lyric"/>
                      </StackPanel>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding}" Value="Song + Lyrics">
                          <Setter TargetName="Example" Property="Text" Value="Song — Artist&#10;Current lyric"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding}" Value="Status / Time">
                          <Setter TargetName="Example" Property="Text" Value="Your status&#10;21:30"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding}" Value="Custom">
                          <Setter TargetName="Example" Property="Text" Value="Custom text and tokens"/>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="Choose a layout. The Chatbox preview shows your actual output." Style="{StaticResource InspectorCaption}" Margin="0,8,0,0"/>
              </StackPanel>
            </local:ColumnScrollViewer>
          </Border>
          <Grid x:Name="DisplayEditorPanel" Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <StackPanel x:Name="CustomPanel" Visibility="Collapsed" Margin="0,0,0,18">
              <DockPanel Margin="0,0,0,10"><Button Content="Decorations menu" Tag="Custom" Click="OpenDecorationPicker" Style="{StaticResource InspectorButton}" DockPanel.Dock="Right" AutomationProperties.Name="Open decorations menu" ToolTip="Add symbols, kaomoji, text art and more"/><TextBlock Text="Custom composition" Style="{StaticResource InspectorHeading}"/></DockPanel>
