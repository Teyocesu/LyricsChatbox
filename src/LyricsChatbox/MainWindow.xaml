          <DockPanel Margin="0,0,0,2" VerticalAlignment="Center">
            <CheckBox x:Name="EnabledBox" DockPanel.Dock="Right" VerticalAlignment="Center" Checked="EnabledChanged" Unchecked="EnabledChanged" AutomationProperties.Name="Enable Chatbox output"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="16" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="Output" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </DockPanel>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
