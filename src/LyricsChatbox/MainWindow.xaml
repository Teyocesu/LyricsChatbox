            <TextBlock x:Name="OutputStateText" Text="Off" Style="{StaticResource Caption}" FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="OutputDestinationText" Text="" Style="{StaticResource Caption}" Margin="0,4,0,0" FontSize="11" AutomationProperties.Name="Configured OSC destination"/>
          <TextBlock x:Name="OutputActivityText" Text="" Style="{StaticResource Caption}" Margin="0,4,0,0" FontSize="11" Visibility="Collapsed"/>
          <TextBlock x:Name="OutputPauseHint" Text="Pause remains scheduled" Style="{StaticResource Caption}" Margin="0,4,0,0" Visibility="Collapsed"/>
