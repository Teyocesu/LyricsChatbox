                <Grid MinHeight="42"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="172"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE895;" Style="{StaticResource AboutRowIcon}" AutomationProperties.Name=" "/><TextBlock Grid.Column="1" Text="Update checks" Style="{StaticResource AboutRowLabel}" Margin="8,0,4,0"/><TextBlock Grid.Column="2" Text="GitHub is contacted only for manual or enabled startup checks." Style="{StaticResource AboutRowValue}"/></Grid>
                <Border Height="1" Background="{DynamicResource LineBrush}" Opacity="0.52"/>
                <Grid MinHeight="42"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="172"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Rectangle Grid.Column="0" Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource TextBrush}" AutomationProperties.Name=" "><Rectangle.OpacityMask><ImageBrush ImageSource="Assets/About/AboutOscNetwork.png" Stretch="Uniform"/></Rectangle.OpacityMask></Rectangle><TextBlock Grid.Column="1" Text="OSC output" Style="{StaticResource AboutRowLabel}" Margin="8,0,4,0"/><TextBlock Grid.Column="2" Text="Lyrics are sent only to your configured OSC destination." Style="{StaticResource AboutRowValue}"/></Grid>
              </StackPanel>
            </StackPanel>
            </Grid>
            <StackPanel x:Name="AboutCompactCascade" Visibility="Collapsed"/>
          </Grid>
          <StackPanel x:Name="AboutUpdates" Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="AboutUpdatesTitle" Text="U P D A T E S" Style="{StaticResource AboutSectionLabel}" AutomationProperties.Name="Updates"/>
            <Border x:Name="AboutUpdatesRule" Height="2" Background="{DynamicResource AccentBrush}" Margin="0,4,0,4"/>
            <Grid x:Name="UpdateSummary" MinHeight="62" Margin="0,4,0,0" VerticalAlignment="Center">
              <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock x:Name="UpdateSummaryIcon" Grid.Row="0" Grid.RowSpan="4" Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" AutomationProperties.Name=" "/>
              <StackPanel x:Name="UpdateStatusGroup" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="6,0,14,0"><TextBlock Text="Stable channel" FontSize="13"/><TextBlock x:Name="UpdateStatus" Text="Check for updates to see the latest stable release." Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel>
              <Border x:Name="UpdateCurrentDivider" Grid.Row="0" Grid.Column="2" Grid.RowSpan="4" Width="1" Background="{DynamicResource LineBrush}" Margin="14,0"/>
              <StackPanel x:Name="UpdateCurrentGroup" Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Margin="10,0"><TextBlock Text="Current version" Style="{StaticResource Caption}" FontSize="11"/><TextBlock x:Name="UpdateCurrentVersion" Text="" FontSize="14" Margin="0,3,0,0"/></StackPanel>
              <Border x:Name="UpdateLastCheckedDivider" Grid.Row="0" Grid.Column="4" Grid.RowSpan="4" Width="1" Background="{DynamicResource LineBrush}" Margin="14,0"/>
              <StackPanel x:Name="UpdateLastCheckedGroup" Grid.Row="0" Grid.Column="5" VerticalAlignment="Center" Margin="10,0"><TextBlock Text="Last checked" Style="{StaticResource Caption}" FontSize="11"/><TextBlock x:Name="UpdateLastChecked" Text="Not checked yet" FontSize="14" Margin="0,3,0,0"/></StackPanel>
              <StackPanel x:Name="UpdateActionGroup" Grid.Row="0" Grid.Column="6" Grid.RowSpan="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button x:Name="CheckUpdatesButton" Click="CheckUpdates" Style="{StaticResource AboutCheckButton}" AutomationProperties.Name="Check for stable updates"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="15" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Check for updates" VerticalAlignment="Center" TextAlignment="Center"/></Grid></Button>
                <ToggleButton x:Name="UpdatePreferencesButton" Content="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16" Width="34" Height="36" MinWidth="34" MinHeight="36" Margin="6,0,0,0" Padding="0" Style="{StaticResource AboutPreferenceButton}" AutomationProperties.Name="Update preferences" ToolTip="Update preferences"/>
                <Popup x:Name="UpdatePreferencesPopup" PlacementTarget="{Binding ElementName=UpdatePreferencesButton}" Placement="Top" VerticalOffset="-4" IsOpen="{Binding IsChecked, ElementName=UpdatePreferencesButton, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"><Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Width="290"><StackPanel><TextBlock Text="Update preferences" FontWeight="SemiBold" Margin="0,0,0,8"/><CheckBox x:Name="AutoUpdateBox" Content="Check for updates at startup" Checked="AutomaticUpdatesChanged" Unchecked="AutomaticUpdatesChanged" AutomationProperties.Name="Check for updates at startup"/><TextBlock Text="GitHub is contacted only for requested checks or when this option is enabled. Updates are never downloaded or installed automatically." Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border></Popup>
              </StackPanel>
            </Grid>
            <Button x:Name="ViewReleaseButton" Content="View release" Click="ViewRelease" Style="{StaticResource AboutAction}" Visibility="Collapsed" HorizontalAlignment="Left" Margin="42,0,0,6" AutomationProperties.Name="View stable release notes on GitHub"/>
            <StackPanel x:Name="ReleaseDetails" Visibility="Collapsed" Margin="42,6,0,12"><TextBlock Text="What's new" Style="{StaticResource AboutSectionLabel}" AutomationProperties.Name="What’s new"/><TextBox x:Name="UpdateNotes" IsReadOnly="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="200" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Release notes" Margin="0,6,0,0"/><WrapPanel Margin="0,10,0,4"><Button x:Name="DownloadInstallerButton" Content="Download verified installer" Click="DownloadInstaller" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" AutomationProperties.Name="Download and verify installer"/><Button x:Name="SkipUpdateButton" Content="Skip this version" Click="SkipUpdate" Margin="0,0,8,6"/><Button x:Name="CancelDownloadButton" Content="Cancel download" Click="CancelInstallerDownload" Visibility="Collapsed" Margin="0,0,0,6"/></WrapPanel><ProgressBar x:Name="DownloadProgress" Maximum="100" Height="4" Visibility="Collapsed" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource RaisedBrush}"/></StackPanel>
            <TextBlock x:Name="DownloadStatus" Style="{StaticResource Caption}" Margin="42,0,0,4"/>
            <Button x:Name="LaunchInstallerButton" Content="Open verified installer…" Click="LaunchInstaller" Visibility="Collapsed" HorizontalAlignment="Left" Margin="42,0,0,8" AutomationProperties.Name="Open verified installer"/>
          </StackPanel>
        </Grid>
      </Grid>
      </ScrollViewer>
      <ContentControl x:Name="PersistentPreviewHost" Grid.Row="2" HorizontalContentAlignment="Stretch">
        <Border x:Name="PreviewCard" Style="{StaticResource Card}" Padding="18">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel x:Name="PreviewHeading" Margin="0,0,0,12"><TextBlock x:Name="BudgetText" Text="0 / 144" Style="{StaticResource Caption}" DockPanel.Dock="Right"/><TextBlock x:Name="PreviewLabel" Text="Live Preview" FontWeight="SemiBold" FontSize="14"/></DockPanel>
            <TextBlock x:Name="PreviewProfileText" Grid.Row="1" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
            <Border x:Name="PreviewFrame" Grid.Row="2" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,0" Background="Transparent" CornerRadius="5" Padding="12,8" Margin="0,0,0,12">
              <Border x:Name="PreviewBubble" Padding="0,4" VerticalAlignment="Center"><ScrollViewer x:Name="PreviewScroller" MaxHeight="130" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="PreviewText" Text="Nothing to send yet" FontSize="20" FontWeight="Light"/></ScrollViewer></Border>
            </Border>
            <StackPanel x:Name="PreviewStatus" Grid.Row="3"><TextBlock x:Name="OwnerText" Text="Automatic" Foreground="{DynamicResource AccentBrush}" FontSize="11"/><TextBlock x:Name="OscText" Text="OSC ready" Style="{StaticResource Caption}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
          </Grid>
        </Border>
      </ContentControl>
      <TextBlock Grid.Row="3" x:Name="ErrorText" Foreground="{DynamicResource WarningBrush}" Margin="0,8,0,0"/>
    </Grid>
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0">
      <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="MinimizeWindow" AutomationProperties.Name="Minimize" ToolTip="Minimize"/>
      <Button x:Name="MaximizeCaptionButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="ToggleMaximizeWindow" AutomationProperties.Name="Maximize or restore" ToolTip="Maximize or restore"/>
      <Button Content="&#xE8BB;" Style="{StaticResource CaptionButton}" Click="CloseWindow" AutomationProperties.Name="Close" ToolTip="Close"/>
    </StackPanel>
  </Grid>
</Window>
