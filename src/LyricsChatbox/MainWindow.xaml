          </ComboBox>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><ContentControl x:Name="CompactSectionHost" HorizontalContentAlignment="Stretch"/><StackPanel x:Name="CompactToolsHost" Visibility="Collapsed"/></Grid></ScrollViewer>
        </Grid>
        </Grid>
      </ScrollViewer>
      <ScrollViewer x:Name="DisplayPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,8,14">
