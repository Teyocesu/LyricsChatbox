                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource HomeChoiceItem}"><Setter Property="Padding" Value="10,4"/><Setter Property="Margin" Value="0,0,0,4"/></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Click="RotationItemEnabledChanged" VerticalAlignment="Center" Margin="0,0,0,0" AutomationProperties.Name="Enable status message"/>
