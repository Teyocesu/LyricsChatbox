              </ItemsControl>
              <TextBlock x:Name="CustomMessageHint" Text="Add {message} to include status or rotating messages." Style="{StaticResource InspectorCaption}" Visibility="Collapsed"/>
            </StackPanel>
            <ContentControl x:Name="DisplayPreviewHost" Grid.Row="1" Focusable="False" VerticalAlignment="Top" HorizontalContentAlignment="Stretch"/>
          </Grid>
