                  <TextBlock x:Name="ArtistText" FontSize="16" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                  <TextBlock x:Name="AlbumText" Style="{StaticResource Caption}" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>
                <TextBlock x:Name="LyricText" Grid.Row="1" Grid.Column="1" Text="—" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="Light" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" Margin="0,12,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                  <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><Trigger Property="Text" Value="—"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </Grid>
              <StackPanel x:Name="HeroTransport" Grid.Row="2" Margin="0,18,0,0">
                <ProgressBar x:Name="PositionProgress" Maximum="1" Height="4" BorderThickness="0" Background="{DynamicResource LineBrush}" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="Playback progress" ToolTip="Seeking is not available here"/>
                <Grid Margin="0,6,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="PositionText" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ShuffleButton" Style="{StaticResource MusicTransportButton}" Content="&#xE8B1;" FontFamily="Segoe Fluent Icons" Tag="Shuffle" Click="TransportClicked" ToolTipService.ShowOnDisabled="True" ToolTip="Shuffle is unavailable" AutomationProperties.Name="Shuffle"/>
                    <Button x:Name="PreviousButton" Style="{StaticResource MusicTransportButton}" Content="&#xE892;" FontFamily="Segoe Fluent Icons" Tag="Previous" Click="TransportClicked" ToolTip="Previous track" AutomationProperties.Name="Previous track"/>
                    <Button x:Name="PlayPauseButton" Style="{StaticResource MusicPlayButton}" Content="&#xE768;" FontFamily="Segoe Fluent Icons" Tag="PlayPause" Click="TransportClicked" Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" Margin="8,0" ToolTip="Play or pause" AutomationProperties.Name="Play or pause"/>
                    <Button x:Name="NextButton" Style="{StaticResource MusicTransportButton}" Content="&#xE893;" FontFamily="Segoe Fluent Icons" Tag="Next" Click="TransportClicked" ToolTip="Next track" AutomationProperties.Name="Next track"/>
                    <Button x:Name="RepeatButton" Style="{StaticResource MusicTransportButton}" Content="&#xE8EE;" FontFamily="Segoe Fluent Icons" Tag="Repeat" Click="TransportClicked" ToolTipService.ShowOnDisabled="True" ToolTip="Repeat is unavailable" AutomationProperties.Name="Repeat"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE767;" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" AutomationProperties.Name=" "/>
                    <Slider x:Name="MusicVolumeSlider" ValueChanged="MusicVolumeChanged" Minimum="0" Maximum="1" Width="96" IsEnabled="False" IsMoveToPointEnabled="True" SmallChange="0.02" LargeChange="0.1" AutomationProperties.Name="Music volume" ToolTip="Music volume" PreviewMouseLeftButtonUp="VolumeReleased" KeyUp="VolumeKeyReleased"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="TransportStatus" Style="{StaticResource Caption}" FontSize="11" TextAlignment="Center" Visibility="Collapsed"/>
              </StackPanel>
            </Grid>
          </Border>
          <Grid x:Name="HomeSectionsPanel" Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <ListBox x:Name="HomeSectionBox" SelectedIndex="0" SelectionChanged="HomeSectionChanged" ItemContainerStyle="{StaticResource HomeSectionTab}" Margin="0,0,0,14" Visibility="Collapsed" AutomationProperties.Name="Home section">
              <ListBox.Template><ControlTemplate TargetType="ListBox"><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"><ItemsPresenter/></Border></ControlTemplate></ListBox.Template>
              <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBoxItem Content="Preview"/><ListBoxItem Content="Profiles"/><ListBoxItem Content="Context"/><ListBoxItem Content="Details"/><ListBoxItem Content="Messages"/><ListBoxItem Content="Tools"/>
            </ListBox>
            <ScrollViewer x:Name="HomeSectionsScroller" Grid.Row="1" Margin="0,0,-24,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" AutomationProperties.Name="Home sections">
              <Grid x:Name="HomeColumns" Margin="0,0,24,8">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel x:Name="HomeLeftColumn">
                  <ContentControl x:Name="HomePreviewHost" HorizontalContentAlignment="Stretch"/>
                  <StackPanel x:Name="InspectorSection">
                    <TextBlock Text="L Y R I C S  D E T A I L S" Style="{StaticResource AboutSectionLabel}" AutomationProperties.Name="Lyrics details"/>
                    <Border Style="{StaticResource HomeSectionRule}"/>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <TextBlock Text="Source" Style="{StaticResource HomeDetailLabel}"/><TextBlock x:Name="InspectorSource" Grid.Column="1" Text="—" Style="{StaticResource HomeDetailValue}"/>
                      <TextBlock Grid.Column="2" Text="Cache" Style="{StaticResource HomeDetailLabel}"/><TextBlock x:Name="InspectorCache" Grid.Column="3" Text="—" Style="{StaticResource HomeDetailValue}"/>
                      <Border Grid.Row="1" Grid.ColumnSpan="4" Style="{StaticResource HomeRowSeparator}"/>
                      <TextBlock Grid.Row="2" Text="{x:Static local:PresentationText.TrackLyricsDurationLabel}" Style="{StaticResource HomeDetailLabel}"/><TextBlock x:Name="InspectorDuration" Grid.Row="2" Grid.Column="1" Text="—" Style="{StaticResource HomeDetailValue}"/>
                      <TextBlock Grid.Row="2" Grid.Column="2" Text="Global offset" Style="{StaticResource HomeDetailLabel}"/><TextBlock x:Name="InspectorGlobalOffset" Grid.Row="2" Grid.Column="3" Text="—" Style="{StaticResource HomeDetailValue}"/>
                      <Border Grid.Row="3" Grid.ColumnSpan="4" Style="{StaticResource HomeRowSeparator}"/>
                      <TextBlock Grid.Row="4" Text="Saved offset" Style="{StaticResource HomeDetailLabel}"/><TextBlock x:Name="InspectorSavedOffset" Grid.Row="4" Grid.Column="1" Text="—" Style="{StaticResource HomeDetailValue}"/>
                      <TextBlock Grid.Row="4" Grid.Column="2" Text="Effective offset" Style="{StaticResource HomeDetailLabel}"/><TextBlock x:Name="InspectorEffectiveOffset" Grid.Row="4" Grid.Column="3" Text="—" Style="{StaticResource HomeDetailValue}" Foreground="{DynamicResource AccentBrush}"/>
                    </Grid>
                    <Expander Header="Recording &amp; timing" FontSize="13" Margin="0,8,0,0">
                      <StackPanel Margin="0,8,0,0">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                          <TextBlock Text="Match" Style="{StaticResource HomeDetailLabel}"/><TextBlock x:Name="InspectorMatch" Grid.Column="1" Text="—" Style="{StaticResource HomeDetailValue}"/>
                          <TextBlock Grid.Row="1" Text="Manual match" Style="{StaticResource HomeDetailLabel}"/><TextBlock x:Name="InspectorManual" Grid.Row="1" Grid.Column="1" Text="—" Style="{StaticResource HomeDetailValue}"/>
                          <TextBlock Grid.Row="2" Text="Ignored" Style="{StaticResource HomeDetailLabel}"/><TextBlock x:Name="InspectorIgnored" Grid.Row="2" Grid.Column="1" Text="—" Style="{StaticResource HomeDetailValue}"/>
                        </Grid>
                        <Button Content="Forget manual match" Click="ForgetMatch" IsEnabled="{Binding IsEnabled, ElementName=ForgetMatchButton}" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0,8,0,12"/>
                        <DockPanel><TextBlock x:Name="OffsetText" Text="0.0 s" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Lyric timing" FontWeight="SemiBold"/></DockPanel>
                        <Slider x:Name="OffsetSlider" ToolTip="Positive timing values show lyrics later." Minimum="-5" Maximum="5" TickFrequency="0.1" SmallChange="0.1" LargeChange="0.5" IsSnapToTickEnabled="True" ValueChanged="OffsetChanged" AutomationProperties.Name="Lyric offset in seconds" Margin="0,6,0,2"/>
                        <TextBlock x:Name="CorrectionStatus" Style="{StaticResource Caption}" Margin="0,4,0,8"/>
                        <WrapPanel><Button x:Name="SaveSongButton" Content="Save for song" Click="SaveSongCorrection" Style="{StaticResource SmallButton}" Margin="0,0,6,6"/><Button x:Name="ResetSongButton" Content="Reset song" Click="ResetSongCorrection" Style="{StaticResource SmallButton}" Margin="0,0,6,6"/><Button Content="Use globally" Click="UseGlobalCorrection" Style="{StaticResource SmallButton}" Margin="0,0,0,6"/></WrapPanel>
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </StackPanel>
                <Border x:Name="HomeColumnDivider" Grid.Column="1" Width="1" Background="{DynamicResource LineBrush}" HorizontalAlignment="Center"/>
                <StackPanel x:Name="HomeRightColumn" Grid.Column="2">
                  <StackPanel x:Name="ProfilesSection">
                    <DockPanel><Button Content="Manage" Click="ManageProfiles" DockPanel.Dock="Right" Style="{StaticResource HomeHeaderAction}" AutomationProperties.Name="Manage profiles"/><TextBlock Text="P R O F I L E S" Style="{StaticResource AboutSectionLabel}" AutomationProperties.Name="Profiles"/></DockPanel>
                    <Border Style="{StaticResource HomeSectionRule}"/>
                    <ListBox x:Name="ProfileCards" SelectionChanged="SelectProfile" SelectedValuePath="Id" ItemContainerStyle="{StaticResource HomeChoiceItem}" AutomationProperties.Name="Saved display profiles">
                      <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
                      <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                      <ListBox.ItemTemplate><DataTemplate><StackPanel MaxWidth="170"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Preset}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                  <StackPanel x:Name="ContextCard">
                    <TextBlock Text="L Y R I C  C O N T E X T" Style="{StaticResource AboutSectionLabel}" AutomationProperties.Name="Lyric context"/>
                    <Border Style="{StaticResource HomeSectionRule}"/>
                    <ListBox x:Name="ContextBox" SelectionChanged="ContextChanged" ItemContainerStyle="{StaticResource HomeChoiceItem}" AutomationProperties.Name="Lyric context mode" ToolTip="{Binding Text, ElementName=ContextHint}">
                      <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
                      <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="ContextHint" Text="Adds nearby lyrics when they fit. The current lyric always stays." Style="{StaticResource Caption}" Margin="0,2,0,0" Visibility="Collapsed"/>
                  </StackPanel>
                  <StackPanel x:Name="QuickMessagesSection">
                    <DockPanel><Button Content="Edit messages" Click="ManageQuickMessages" DockPanel.Dock="Right" Style="{StaticResource HomeHeaderAction}"/><TextBlock Text="Q U I C K  M E S S A G E S" Style="{StaticResource AboutSectionLabel}" AutomationProperties.Name="Quick messages"/></DockPanel>
                    <Border Style="{StaticResource HomeSectionRule}"/>
                    <TextBlock Text="Choose a draft, then Send." Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="HomeQuickMessages" ItemTemplate="{StaticResource HomeQuickTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                    <TextBlock x:Name="QuickEmptyText" Text="Add reusable messages in Manual." Style="{StaticResource Caption}" Visibility="Collapsed"/>
                  </StackPanel>
                  <StackPanel x:Name="HomeToolsSection">
                    <TextBlock Text="L Y R I C S  T O O L S" Style="{StaticResource AboutSectionLabel}" AutomationProperties.Name="Lyrics tools"/>
                    <Border Style="{StaticResource HomeSectionRule}"/>
                    <StackPanel x:Name="RecoveryCard" Visibility="Collapsed" Margin="0,0,0,10">
                      <TextBlock x:Name="RecoveryTitle" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,2"/>
                      <TextBlock x:Name="RecoveryHint" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <WrapPanel>
                      <Button x:Name="HomeRetryButton" Content="Retry lyrics" Click="RetryLyrics" Style="{StaticResource SmallButton}" Margin="0,0,8,6" Visibility="Collapsed"/>
                      <Button x:Name="InspectorSearchButton" Content="Search alternatives" Click="OpenMatches" Style="{StaticResource SmallButton}" Margin="0,0,8,6"/>
                      <Button x:Name="HomeImportButton" Content="Import LRC…" Click="ImportLrc" IsEnabled="{Binding IsEnabled, ElementName=ImportButton}" Style="{StaticResource SmallButton}" Margin="0,0,8,6"/>
                      <Button x:Name="IgnoreButton" Content="Ignore this recording" Click="ToggleIgnore" Style="{StaticResource SmallButton}" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <StackPanel x:Name="MatchPanel" Visibility="Collapsed" Margin="0,8,0,0">
                      <TextBox x:Name="MatchQuery" MaxLength="512" AutomationProperties.Name="Search lyrics candidates"/>
                      <WrapPanel Margin="0,8,0,8"><Button x:Name="SearchMatchesButton" Content="Search" Click="SearchMatches" Style="{StaticResource SmallButton}" Margin="0,0,8,4"/><Button x:Name="UseMatchButton" Content="Use selected match" Click="UseMatch" Style="{StaticResource SmallButton}" Margin="0,0,8,4"/><Button Content="Cancel" Click="CloseMatches" Style="{StaticResource SmallButton}" Margin="0,0,0,4"/></WrapPanel>
                      <TextBlock x:Name="MatchStatus" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                      <ListBox x:Name="MatchChoices" MaxHeight="220" Background="{DynamicResource RaisedBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Candidate recordings">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" Margin="6" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                      </ListBox>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Grid>
      <ScrollViewer x:Name="DisplayPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
        <StackPanel x:Name="DisplayCanvas" MaxWidth="1400">
          <Grid Height="22" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource AccentBrush}"/>
            <TextBlock Grid.Column="2" Text="D I S P L A Y" Style="{StaticResource AboutSectionLabel}" AutomationProperties.Name="Display"/>
          </Grid>
          <TextBlock Text="P R O F I L E" Style="{StaticResource AboutSectionLabel}" AutomationProperties.Name="Profile"/>
          <Border Style="{StaticResource HomeSectionRule}"/>
          <WrapPanel>
            <ComboBox Width="220" MinHeight="38" Margin="0,0,12,8" ItemsSource="{Binding ItemsSource, ElementName=ProfileCards}" SelectedValue="{Binding SelectedValue, ElementName=ProfileCards, Mode=TwoWay}" SelectedValuePath="Id" DisplayMemberPath="Name" AutomationProperties.Name="Selected profile"/>
            <Grid Width="270" Margin="0,0,12,8">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="ProfileNameBox" MaxLength="40" Padding="12,8" AutomationProperties.Name="Profile name" Margin="0,0,8,0"/>
              <Button Content="Rename" Click="RenameProfile" Grid.Column="1"/>
            </Grid>
            <Button Content="New profile" Click="NewProfile" Margin="0,0,8,8"/>
            <Button Content="Duplicate" Click="DuplicateProfile" Margin="0,0,8,8"/>
            <Button x:Name="DeleteProfileButton" Content="Delete profile" Click="DeleteProfile" Margin="0,0,0,8"/>
          </WrapPanel>
          <TextBlock x:Name="ProfileStatus" Text="Changes save automatically. Appearance stays global." Style="{StaticResource Caption}"/>
          <Grid x:Name="DisplayColumns" Margin="0,24,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="48"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel x:Name="DisplayPrimaryColumn">
              <TextBlock Text="C O M P O S I T I O N" Style="{StaticResource AboutSectionLabel}" AutomationProperties.Name="Composition"/>
              <Border Style="{StaticResource HomeSectionRule}"/>
              <ListBox x:Name="PresetBox" SelectionChanged="DisplayChanged" ItemContainerStyle="{StaticResource HomeChoiceItem}" AutomationProperties.Name="Display preset">
                <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding}" FontWeight="SemiBold"/>
                      <TextBlock x:Name="Example" Style="{StaticResource Caption}" Margin="0,2,0,0" Text="Current lyric"/>
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding}" Value="Song + Lyrics">
                        <Setter TargetName="Example" Property="Text" Value="Song — Artist&#10;Current lyric"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding}" Value="Status / Time">
                        <Setter TargetName="Example" Property="Text" Value="Your status&#10;21:30"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding}" Value="Custom">
                        <Setter TargetName="Example" Property="Text" Value="Custom text and tokens"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="Choose a layout. The live preview below shows your actual output." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
              <StackPanel x:Name="CustomPanel" Visibility="Collapsed" Margin="0,16,0,0">
                <DockPanel Margin="0,0,0,8"><Button Content="Decorations menu" Tag="Custom" Click="OpenDecorationPicker" Style="{StaticResource SmallButton}" DockPanel.Dock="Right" AutomationProperties.Name="Open decorations menu" ToolTip="Add symbols, kaomoji, text art and more"/><TextBlock Text="Custom composition" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                <TextBox x:Name="TemplateBox" FontFamily="Consolas" MaxLength="512" AcceptsReturn="True" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto" TextChanged="DisplayChanged" AutomationProperties.Name="Custom template"/>
                <ItemsControl x:Name="TokenChips" Margin="0,10,0,0">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Token}" Tag="{Binding Token}" Click="InsertCompositionToken" Style="{StaticResource SmallButton}" Margin="0,0,6,6" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Description}"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="CustomMessageHint" Text="Add {message} to include status or rotating messages." Style="{StaticResource Caption}" Visibility="Collapsed"/>
              </StackPanel>
              <StackPanel x:Name="StatusPanel" Margin="0,24,0,0" Visibility="Collapsed">
                <DockPanel><TextBlock x:Name="RotationCountText" Text="0 / 16 messages" Style="{StaticResource Caption}" DockPanel.Dock="Right" VerticalAlignment="Center"/><TextBlock Text="S T A T U S  M E S S A G E S" Style="{StaticResource AboutSectionLabel}" AutomationProperties.Name="Status messages"/></DockPanel>
                <Border Style="{StaticResource HomeSectionRule}"/>
                <WrapPanel>
                  <CheckBox x:Name="RotationEnabledBox" Content="Rotate messages" Checked="RotationEnabledChanged" Unchecked="RotationEnabledChanged" Margin="0,0,24,8"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="Change every" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="RotationIntervalBox" Width="130" SelectionChanged="RotationIntervalChanged" AutomationProperties.Name="Message rotation interval"/></StackPanel>
                </WrapPanel>
                <ListBox x:Name="RotationList" SelectionChanged="RotationSelectionChanged" MaxHeight="180" Margin="0,0,0,8" Padding="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Status messages">
                  <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource HomeChoiceItem}"><Setter Property="Padding" Value="10,4"/><Setter Property="Margin" Value="0,0,0,4"/></Style></ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Click="RotationItemEnabledChanged" VerticalAlignment="Center" Margin="0,0,8,0" AutomationProperties.Name="Enable status message"/>
                        <TextBlock Grid.Column="1" Text="{Binding Preview}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="↑" Tag="Up" Click="MoveRotationMessage" IsEnabled="{Binding CanMoveUp}" Style="{StaticResource SmallButton}" Margin="8,0,4,0" ToolTip="Move up" AutomationProperties.Name="Move message up"/>
                        <Button Grid.Column="3" Content="↓" Tag="Down" Click="MoveRotationMessage" IsEnabled="{Binding CanMoveDown}" Style="{StaticResource SmallButton}" ToolTip="Move down" AutomationProperties.Name="Move message down"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <DockPanel Margin="0,0,0,8"><Button x:Name="AddRotationMessageButton" Content="+ Add message" Click="AddRotationMessage" Style="{StaticResource SmallButton}" DockPanel.Dock="Left" Margin="0,0,12,0"/><TextBlock x:Name="RotationRuntimeText" Text="Rotation off" Foreground="{DynamicResource AccentBrush}" FontSize="13" VerticalAlignment="Center"/></DockPanel>
                <StackPanel x:Name="RotationEditorPanel" Visibility="Collapsed" Margin="0,8,0,0">
                  <TextBlock x:Name="RotationEditorTitle" Text="Selected message" FontWeight="SemiBold" Margin="0,0,0,6"/>
                  <TextBox x:Name="RotationMessageBox" FontFamily="Consolas" MaxLength="512" AcceptsReturn="True" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Status message text"/>
                  <WrapPanel x:Name="RotationEditorActions" Margin="0,10,0,0"><Button Content="Decorations menu" Tag="Rotation" Click="OpenDecorationPicker" Style="{StaticResource SmallButton}" Margin="0,0,6,6" AutomationProperties.Name="Open decorations menu" ToolTip="Add symbols, kaomoji, text art and more"/><Button Content="Save" Click="SaveRotationMessage" Style="{StaticResource SmallButton}" Margin="0,0,6,6"/><Button x:Name="RemoveRotationMessageButton" Content="Remove" Click="RemoveRotationMessage" Style="{StaticResource SmallButton}" Margin="0,0,0,6"/></WrapPanel>
                  <Border x:Name="RotationRemoveConfirmation" Visibility="Collapsed" Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,4">
                    <StackPanel><TextBlock Text="Remove this message?" FontWeight="SemiBold" Margin="0,0,0,10"/><WrapPanel><Button Content="Cancel" Click="CancelRotationMessageRemoval" Margin="0,0,8,0" AutomationProperties.Name="Cancel removal"/><Button Content="Remove message" Click="ConfirmRemoveRotationMessage" Foreground="{DynamicResource WarningBrush}" AutomationProperties.Name="Confirm remove message"/></WrapPanel></StackPanel>
                  </Border>
                  <TextBlock x:Name="RotationEditStatus" Style="{StaticResource Caption}"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
            <Border x:Name="DisplayColumnDivider" Grid.Column="1" Width="1" Background="{DynamicResource LineBrush}" HorizontalAlignment="Center"/>
            <StackPanel x:Name="DisplaySupportColumn" Grid.Column="2">
              <StackPanel x:Name="LyricContextPanel">
                <TextBlock Text="L Y R I C  C O N T E X T" Style="{StaticResource AboutSectionLabel}" AutomationProperties.Name="Lyric context"/>
                <Border Style="{StaticResource HomeSectionRule}"/>
                <ComboBox x:Name="ProfileContextBox" ItemsSource="{Binding ItemsSource, ElementName=ContextBox}" SelectedItem="{Binding SelectedItem, ElementName=ContextBox, Mode=TwoWay}" AutomationProperties.Name="Profile lyric context"/>
                <TextBlock x:Name="ProfileContextHint" Text="Nearby lyrics are included only when they fit; the current lyric always stays." Style="{StaticResource Caption}" Margin="0,6,0,0"/>
              </StackPanel>
              <TextBlock Text="P R E S E N T A T I O N" Style="{StaticResource AboutSectionLabel}" Margin="0,24,0,0" AutomationProperties.Name="Presentation"/>
              <Border Style="{StaticResource HomeSectionRule}"/>
