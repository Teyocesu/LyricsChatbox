            <Border Background="{DynamicResource CanvasBrush}"><Border.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00000000" Offset="0.72"/><GradientStop Color="#FF000000" Offset="1"/></LinearGradientBrush></Border.OpacityMask></Border>
