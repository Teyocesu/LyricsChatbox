<Window x:Class="LyricsChatbox.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LyricsChatbox" Width="560" Height="760" MinWidth="510" MinHeight="650" Background="#10151F" Foreground="#EBF0F7" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#DFE8FA"/><Setter Property="Foreground" Value="#182234"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Background" Value="#232D3E"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#53617A"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EBF0F7"/></Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#EBF0F7"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="#1D283B" Padding="16,9" Margin="0,0,3,0" CornerRadius="5,5,0,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#375273"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <DockPanel Margin="0,0,0,16"><TextBlock Text="LyricsChatbox" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="LOCAL · v0.2" Foreground="#98AAC7" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
      <CheckBox x:Name="EnabledBox" Content="Enable Chatbox output" FontSize="16" Checked="EnabledChanged" Unchecked="EnabledChanged" Margin="0,0,0,12"/>
      <CheckBox x:Name="CompactBox" Content="Compact / Floating Chatbox" Checked="DisplayChanged" Unchecked="DisplayChanged" Margin="0,0,0,16" ToolTip="Uses VRChat's current Chatbox rendering behavior and may change after VRChat updates."/>
    </StackPanel>
    <TabControl x:Name="ModeTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#EBF0F7">
      <TabItem Header="Playback"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,6,6">
        <TextBlock x:Name="SourceText" Text="Connecting to Apple Music…" Foreground="#A4B9DB" Margin="0,0,0,10"/>
        <TextBlock x:Name="TrackText" Text="Waiting for a track" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="ArtistText" Foreground="#A4B9DB" Margin="0,5,0,12" TextWrapping="Wrap"/>
        <Border Background="#1D283B" CornerRadius="8" Padding="14" MinHeight="80"><TextBlock x:Name="LyricText" Text="—" FontSize="19" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
        <TextBlock x:Name="LyricsStatusText" Text="Waiting for a track" Foreground="#A4B9DB" Margin="0,9,0,4" TextWrapping="Wrap"/>
        <TextBlock x:Name="PositionText" Foreground="#8397B8" FontSize="12" Margin="0,0,0,14"/>
        <DockPanel><TextBlock Text="Lyric offset"/><TextBlock x:Name="OffsetText" Text="0.0 s" HorizontalAlignment="Right"/></DockPanel>
        <Slider x:Name="OffsetSlider" Minimum="-5" Maximum="5" TickFrequency="0.1" SmallChange="0.1" LargeChange="0.5" IsSnapToTickEnabled="True" ValueChanged="OffsetChanged" Margin="0,8,0,2" AutomationProperties.Name="Lyric offset in seconds"/>
        <TextBlock Text="Positive = show lyrics later" Foreground="#8397B8" FontSize="12" Margin="0,0,0,14"/>
        <WrapPanel><Button x:Name="ImportButton" Content="Use local LRC…" Click="ImportLrc"/><Button Content="Retry lyrics" Click="RetryLyrics"/><Button Content="Open data folder" Click="OpenData"/></WrapPanel>
        <Expander Header="OSC destination" Foreground="#A4B9DB" Margin="0,16,0,0"><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,10,0"><TextBlock Text="Host"/><TextBox x:Name="HostBox" Text="127.0.0.1" AutomationProperties.Name="OSC host"/></StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Port"/><TextBox x:Name="PortBox" Text="9000" AutomationProperties.Name="OSC port"/></StackPanel>
          <Button Grid.Column="2" Content="Apply" Click="ApplyOsc" VerticalAlignment="Bottom" Margin="0"/>
        </Grid></Expander>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Display"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,6,6">
        <TextBlock Text="Automatic display" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock Text="Preset" Margin="0,0,0,5"/>
        <ComboBox x:Name="PresetBox" SelectionChanged="DisplayChanged" Foreground="#182234" Padding="7" Margin="0,0,0,14" AutomationProperties.Name="Display preset"/>
        <TextBlock Text="Custom template" Margin="0,0,0,5"/>
        <TextBox x:Name="TemplateBox" MaxLength="512" AcceptsReturn="True" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto" TextChanged="DisplayChanged" AutomationProperties.Name="Custom template"/>
        <TextBlock Text="{}{lyrics}  {title}  {artist}  {album}  {time}&#10;{message}  {elapsed}  {duration}" Foreground="#98AAC7" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,14"/>
        <TextBlock Text="Custom status · {message}" Margin="0,0,0,5"/>
        <TextBox x:Name="MessageBox" MaxLength="512" AcceptsReturn="True" TextWrapping="Wrap" Height="70" TextChanged="DisplayChanged" AutomationProperties.Name="Custom status"/>
        <TextBlock Text="Time uses your local clock. Missing fields and unknown tokens are omitted. Your status and template are saved locally." Foreground="#98AAC7" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Manual"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,6,6">
        <TextBlock Text="Manual Chatbox" FontSize="19" FontWeight="SemiBold"/>
        <TextBlock Text="Editing takes priority over automatic lyrics. Send holds your message for 8 seconds, then resumes automatic display." Foreground="#A4B9DB" TextWrapping="Wrap" Margin="0,8,0,12"/>
        <TextBox x:Name="DraftBox" MaxLength="2048" AcceptsReturn="True" TextWrapping="Wrap" Height="130" VerticalScrollBarVisibility="Auto" TextChanged="DraftChanged" GotKeyboardFocus="DraftFocused" LostKeyboardFocus="DraftUnfocused" AutomationProperties.Name="Manual message"/>
        <WrapPanel Margin="0,12,0,14"><Button x:Name="SendButton" Content="Send" Click="SendManual"/><Button x:Name="ClearButton" Content="Clear" Click="ClearManual"/><Button Content="Resume Automatic" Click="ResumeAutomatic"/></WrapPanel>
        <CheckBox x:Name="TypingBox" Content="Typing indicator" Checked="DisplayChanged" Unchecked="DisplayChanged" Margin="0,0,0,12"/>
        <CheckBox x:Name="LiveBox" Content="Live edit · show draft while typing" Checked="LiveChanged" Unchecked="LiveChanged"/>
        <TextBlock Text="Drafts are not saved. Live edit sends only the latest draft at the normal Chatbox cadence. Resume Automatic releases manual control immediately." Foreground="#98AAC7" TextWrapping="Wrap" FontSize="12" Margin="0,14,0,0"/>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Margin="0,12,0,0">
      <DockPanel Margin="0,0,0,5"><TextBlock x:Name="OwnerText" Text="Automatic · preview" Foreground="#A4B9DB"/><TextBlock x:Name="BudgetText" Text="0 / 144" HorizontalAlignment="Right" Foreground="#98AAC7"/></DockPanel>
      <Border Background="#1D283B" CornerRadius="8" Padding="12"><ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="PreviewText" Text="—" TextWrapping="Wrap" FontSize="17"/></ScrollViewer></Border>
      <TextBlock x:Name="OscText" Text="OSC ready · delivery unconfirmed" Foreground="#8397B8" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
    <TextBlock Grid.Row="3" x:Name="ErrorText" Foreground="#FFBF9B" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </Grid>
</Window>
