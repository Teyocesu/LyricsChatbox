                <Grid MinHeight="42"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="172"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8B7;" Style="{StaticResource AboutRowIcon}" AutomationProperties.Name=" "/><TextBlock Grid.Column="1" Text="Open Data Folder" Style="{StaticResource AboutRowLabel}" Margin="8,0,4,0"/><Button Grid.Column="2" Grid.ColumnSpan="2" Click="OpenData" Style="{StaticResource AboutAction}" AutomationProperties.Name="Open LyricsChatbox data folder"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><TextBlock Text="View app data" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="&#xE72A;" Foreground="{DynamicResource AccentBrush}" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Button></Grid>
                <Border Height="1" Background="{DynamicResource LineBrush}" Opacity="0.28"/>
                <Grid x:Name="AboutDiagnosticsRow" MinHeight="42">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="172"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Text="&#xE9D9;" Style="{StaticResource AboutRowIcon}" AutomationProperties.Name=" "/>
                  <TextBlock Grid.Column="1" Text="Diagnostics" Style="{StaticResource AboutRowLabel}" Margin="8,0,4,0"/>
                  <TextBlock x:Name="DiagnosticsDescription" Grid.Column="2" Text="Generate diagnostic info" Style="{StaticResource AboutRowValue}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                  <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="DiagnosticsCopyButton" Content="Copy" Style="{StaticResource AboutDiagnosticsButton}" Click="CopyDiagnostics" ToolTip="Copy diagnostics to the clipboard; review before sharing." AutomationProperties.Name="Copy diagnostics" Margin="0,0,6,0"/>
                    <Button x:Name="DiagnosticsExportButton" Content="Export" Style="{StaticResource AboutDiagnosticsButton}" Click="ExportDiagnostics" ToolTip="Export diagnostics to a JSON file; review before sharing." AutomationProperties.Name="Export diagnostics"/>
                  </StackPanel>
                  <TextBlock x:Name="DiagnosticsStatus" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Right" AutomationProperties.LiveSetting="Polite"/>
                </Grid>
                <TextBlock x:Name="ProjectStatus" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
              </StackPanel>
            </StackPanel>
              <Border x:Name="AboutCenterDivider" Grid.Column="1" Width="1" Background="{DynamicResource LineBrush}" HorizontalAlignment="Center"/>
            <StackPanel x:Name="AboutRightColumn" Grid.Column="2">
              <StackPanel x:Name="AboutCommunity">
                <TextBlock x:Name="AboutCommunityTitle" Text="C O M M U N I T Y  &amp;  C O N T A C T" Style="{StaticResource AboutSectionLabel}" AutomationProperties.Name="Community and Contact"/>
                <Border x:Name="AboutCommunityRule" Height="2" Background="{DynamicResource AccentBrush}" Margin="0,4,0,4"/>
                <Grid MinHeight="42"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="172"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><Path Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource TextBrush}" Data="{StaticResource GitHubMarkGeometry}" AutomationProperties.Name=" "/><TextBlock Grid.Column="1" Text="GitHub" Style="{StaticResource AboutRowLabel}" Margin="8,0,4,0"/><Button Grid.Column="2" Grid.ColumnSpan="2" Click="OpenAuthorGitHub" Style="{StaticResource AboutAction}" ToolTip="https://github.com/Teyocesu" AutomationProperties.Name="Open Teyocesu GitHub profile"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><TextBlock Text="View my profile" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="&#xE72A;" Foreground="{DynamicResource AccentBrush}" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Button></Grid>
                <Border Height="1" Background="{DynamicResource LineBrush}" Opacity="0.28"/>
                <Grid MinHeight="42"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="172"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><Image x:Name="VrChatLogoMark" Source="{StaticResource VrChatLogoCropped}" Width="48" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name=" "/><TextBlock Grid.Column="1" Text="VRChat" Style="{StaticResource AboutRowLabel}" Margin="8,0,4,0"/><Button Grid.Column="2" Grid.ColumnSpan="2" Click="OpenVrChatProfile" Style="{StaticResource AboutAction}" AutomationProperties.Name="Open Teyocesu VRChat profile"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><TextBlock Text="Find me in VRChat" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="&#xE72A;" Foreground="{DynamicResource AccentBrush}" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Button></Grid>
                <Border Height="1" Background="{DynamicResource LineBrush}" Opacity="0.28"/>
                <Grid MinHeight="42"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="172"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><Image x:Name="DiscordClydeMark" Source="Assets/Brand/Discord-Symbol-Blurple.png" Width="32" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name=" "/><TextBlock Grid.Column="1" Text="Discord" Style="{StaticResource AboutRowLabel}" Margin="8,0,4,0"/><Button Grid.Column="2" Grid.ColumnSpan="2" Click="CopyDiscordName" Style="{StaticResource AboutAction}" AutomationProperties.Name="Copy Discord username"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><TextBlock Text="teyocesu" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="&#xE8C8;" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Button></Grid>
                <TextBlock x:Name="CommunityStatus" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
              </StackPanel>
                <StackPanel x:Name="AboutPrivacy" Margin="0,22,0,0">
                <TextBlock x:Name="AboutPrivacyTitle" Text="P R I V A C Y  &amp;  D A T A" Style="{StaticResource AboutSectionLabel}" AutomationProperties.Name="Privacy and Data"/>
                <Border x:Name="AboutPrivacyRule" Height="2" Background="{DynamicResource AccentBrush}" Margin="0,4,0,4"/>
                <Grid MinHeight="42"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="172"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE7F4;" Style="{StaticResource AboutRowIcon}" AutomationProperties.Name=" "/><TextBlock Grid.Column="1" Text="Runs locally" Style="{StaticResource AboutRowLabel}" Margin="8,0,4,0"/><TextBlock Grid.Column="2" Text="Core processing stays on your PC." Style="{StaticResource AboutRowValue}"/></Grid>
                <Border Height="1" Background="{DynamicResource LineBrush}" Opacity="0.28"/>
                <Grid MinHeight="42"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="172"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE72E;" Style="{StaticResource AboutRowIcon}" AutomationProperties.Name=" "/><TextBlock Grid.Column="1" Text="No account required" Style="{StaticResource AboutRowLabel}" Margin="8,0,4,0"/><TextBlock Grid.Column="2" Text="Use LyricsChatbox without signing in." Style="{StaticResource AboutRowValue}"/></Grid>
                <Border Height="1" Background="{DynamicResource LineBrush}" Opacity="0.28"/>
                <Grid MinHeight="42"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="172"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Width="23" Height="23" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.7" StrokeLineJoin="Round" Data="M 1,12 C 4,6 8,3 12,3 C 18,3 22,12 22,12 C 20,15 17,18 14,19 M 9,20 C 5,19 2,15 1,12 M 4,4 L 20,20 M 10,10 A 3,3 0 0 0 14,14" AutomationProperties.Name=" "/><TextBlock Grid.Column="1" Text="No telemetry" Style="{StaticResource AboutRowLabel}" Margin="8,0,4,0"/><TextBlock Grid.Column="2" Text="No analytics or usage tracking." Style="{StaticResource AboutRowValue}"/></Grid>
                <Border Height="1" Background="{DynamicResource LineBrush}" Opacity="0.28"/>
                <Grid MinHeight="42"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="172"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE753;" Style="{StaticResource AboutRowIcon}" AutomationProperties.Name=" "/><TextBlock Grid.Column="1" Text="Lyrics lookups" Style="{StaticResource AboutRowLabel}" Margin="8,0,4,0"/><TextBlock Grid.Column="2" Text="Song metadata is sent only when a public lyrics provider is queried." Style="{StaticResource AboutRowValue}"/></Grid>
                <Border Height="1" Background="{DynamicResource LineBrush}" Opacity="0.28"/>
                <Grid MinHeight="42"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="172"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE895;" Style="{StaticResource AboutRowIcon}" AutomationProperties.Name=" "/><TextBlock Grid.Column="1" Text="Update checks" Style="{StaticResource AboutRowLabel}" Margin="8,0,4,0"/><TextBlock Grid.Column="2" Text="GitHub is contacted only for manual or enabled startup checks." Style="{StaticResource AboutRowValue}"/></Grid>
                <Border Height="1" Background="{DynamicResource LineBrush}" Opacity="0.28"/>
                <Grid MinHeight="42"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="172"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Rectangle Grid.Column="0" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource TextBrush}" AutomationProperties.Name=" "><Rectangle.OpacityMask><ImageBrush ImageSource="Assets/About/AboutOscRouting.png" Stretch="Uniform"/></Rectangle.OpacityMask></Rectangle><TextBlock Grid.Column="1" Text="OSC output" Style="{StaticResource AboutRowLabel}" Margin="8,0,4,0"/><TextBlock Grid.Column="2" Text="Lyrics are sent only to your configured OSC destination." Style="{StaticResource AboutRowValue}"/></Grid>
              </StackPanel>
            </StackPanel>
            </Grid>
            <StackPanel x:Name="AboutCompactCascade" Visibility="Collapsed"/>
          </Grid>
          <StackPanel x:Name="AboutUpdates" Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="AboutUpdatesTitle" Text="U P D A T E S" Style="{StaticResource AboutSectionLabel}" AutomationProperties.Name="Updates"/>
            <Border x:Name="AboutUpdatesRule" Height="2" Background="{DynamicResource AccentBrush}" Margin="0,4,0,4"/>
            <Grid x:Name="UpdateSummary" MinHeight="62" Margin="0,4,0,0" VerticalAlignment="Center">
              <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock x:Name="UpdateSummaryIcon" Grid.Row="0" Grid.RowSpan="4" Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" AutomationProperties.Name=" "/>
              <StackPanel x:Name="UpdateStatusGroup" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="6,0,14,0"><TextBlock Text="Stable channel" FontSize="13"/><TextBlock x:Name="UpdateStatus" Text="Check for updates to see the latest stable release." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
              <Border x:Name="UpdateCurrentDivider" Grid.Row="0" Grid.Column="2" Grid.RowSpan="4" Width="1" Background="{DynamicResource LineBrush}" Margin="14,0"/>
              <StackPanel x:Name="UpdateCurrentGroup" Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Margin="10,0"><TextBlock Text="Current version" Style="{StaticResource Caption}" FontSize="11"/><TextBlock x:Name="UpdateCurrentVersion" Text="" FontSize="14" Margin="0,3,0,0"/></StackPanel>
              <Border x:Name="UpdateLastCheckedDivider" Grid.Row="0" Grid.Column="4" Grid.RowSpan="4" Width="1" Background="{DynamicResource LineBrush}" Margin="14,0"/>
              <StackPanel x:Name="UpdateLastCheckedGroup" Grid.Row="0" Grid.Column="5" VerticalAlignment="Center" Margin="10,0"><TextBlock Text="Last checked" Style="{StaticResource Caption}" FontSize="11"/><TextBlock x:Name="UpdateLastChecked" Text="Not checked yet" FontSize="14" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
              <StackPanel x:Name="UpdateActionGroup" Grid.Row="0" Grid.Column="6" Grid.RowSpan="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button x:Name="CheckUpdatesButton" Click="CheckUpdates" Style="{StaticResource AboutCheckButton}" AutomationProperties.Name="Check for stable updates"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="15" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Check for updates" VerticalAlignment="Center" TextAlignment="Center"/></Grid></Button>
                <ToggleButton x:Name="UpdatePreferencesButton" Content="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16" Width="34" Height="36" MinWidth="34" MinHeight="36" Margin="6,0,0,0" Padding="0" Style="{StaticResource AboutPreferenceButton}" AutomationProperties.Name="Update preferences" ToolTip="Update preferences"/>
                <Popup x:Name="UpdatePreferencesPopup" PlacementTarget="{Binding ElementName=UpdatePreferencesButton}" Placement="Top" VerticalOffset="-4" IsOpen="{Binding IsChecked, ElementName=UpdatePreferencesButton, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"><Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Width="290"><StackPanel><TextBlock Text="Update preferences" FontWeight="SemiBold" Margin="0,0,0,8"/><CheckBox x:Name="AutoUpdateBox" Content="Check for updates at startup" Checked="AutomaticUpdatesChanged" Unchecked="AutomaticUpdatesChanged" AutomationProperties.Name="Check for updates at startup"/><TextBlock Text="GitHub is contacted only for requested checks or when this option is enabled. Updates are never downloaded or installed automatically." Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border></Popup>
              </StackPanel>
            </Grid>
            <Button x:Name="ViewReleaseButton" Content="View release" Click="ViewRelease" Style="{StaticResource AboutAction}" Visibility="Collapsed" HorizontalAlignment="Left" Margin="42,0,0,6" AutomationProperties.Name="View stable release notes on GitHub"/>
            <StackPanel x:Name="ReleaseDetails" Visibility="Collapsed" Margin="42,6,0,12"><TextBlock Text="What's new" Style="{StaticResource AboutSectionLabel}" AutomationProperties.Name="What’s new"/><TextBox x:Name="UpdateNotes" IsReadOnly="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="200" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Release notes" Margin="0,6,0,0"/><WrapPanel Margin="0,10,0,4"><Button x:Name="DownloadInstallerButton" Content="Download verified installer" Click="DownloadInstaller" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" AutomationProperties.Name="Download and verify installer"/><Button x:Name="SkipUpdateButton" Content="Skip this version" Click="SkipUpdate" Margin="0,0,8,6"/><Button x:Name="CancelDownloadButton" Content="Cancel download" Click="CancelInstallerDownload" Visibility="Collapsed" Margin="0,0,0,6"/></WrapPanel><ProgressBar x:Name="DownloadProgress" Maximum="100" Height="4" Visibility="Collapsed" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource RaisedBrush}"/></StackPanel>
            <TextBlock x:Name="DownloadStatus" Margin="42,0,0,4">
              <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <Button x:Name="LaunchInstallerButton" Content="Open verified installer…" Click="LaunchInstaller" Visibility="Collapsed" HorizontalAlignment="Left" Margin="42,0,0,8" AutomationProperties.Name="Open verified installer"/>
          </StackPanel>
        </Grid>
        </Grid>
        </ScrollViewer>
      </Grid>
      <ContentControl x:Name="PersistentPreviewHost" Grid.Row="2" Focusable="False" Margin="30,0" MaxWidth="1400" HorizontalContentAlignment="Stretch">
        <Grid x:Name="PreviewPanel">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel x:Name="PreviewHeading"><TextBlock x:Name="BudgetText" Text="0 / 144" Style="{StaticResource InspectorCaption}" DockPanel.Dock="Right" VerticalAlignment="Center"/><TextBlock Text="Chatbox preview" Style="{StaticResource InspectorHeading}" AutomationProperties.Name="Chatbox preview"/></DockPanel>
          <Border x:Name="PreviewFrame" Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource InputBrush}" CornerRadius="7">
            <Border x:Name="PreviewBubble" Padding="0,4" CornerRadius="6" VerticalAlignment="Center"><ScrollViewer x:Name="PreviewScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="PreviewText" Text="Nothing to send yet" FontSize="17"/></ScrollViewer></Border>
          </Border>
          <TextBlock x:Name="PreviewProfileText" Grid.Row="2" Style="{StaticResource InspectorCaption}"/>
          <StackPanel x:Name="PreviewStatus" Grid.Row="3" Orientation="Horizontal"><TextBlock x:Name="OwnerText" Text="Automatic" Foreground="{DynamicResource AccentTextBrush}" FontSize="13"/><TextBlock x:Name="OscText" Text="OSC ready" Style="{StaticResource InspectorCaption}" Margin="10,0,0,0"/></StackPanel>
        </Grid>
      </ContentControl>
      <TextBlock Grid.Row="3" x:Name="ErrorText" Panel.ZIndex="2" Foreground="{DynamicResource WarningBrush}" Margin="30,8">
        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
    </Grid>
    <Border x:Name="OutputPanel" Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="16,0,8,0">
          <TextBlock Text="Output" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <CheckBox x:Name="EnabledBox" VerticalAlignment="Center" Checked="EnabledChanged" Unchecked="EnabledChanged" AutomationProperties.Name="Enable Chatbox output"/>
        </StackPanel>
        <Border Grid.Column="1" Style="{StaticResource StatusSegment}">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="OutputStatusDot" Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBlock x:Name="OutputStateText" Text="Off" Style="{StaticResource StatusText}" FontWeight="SemiBold" MaxWidth="220"/>
          </StackPanel>
        </Border>
        <DockPanel Grid.Column="2" LastChildFill="False">
          <Border Style="{StaticResource StatusSegment}"><TextBlock x:Name="OutputDestinationText" Text="" Style="{StaticResource StatusText}" AutomationProperties.Name="Configured OSC destination"/></Border>
          <Border Style="{StaticResource StatusSegment}" Visibility="{Binding Visibility, ElementName=OutputActivityText}"><TextBlock x:Name="OutputActivityText" Text="" Style="{StaticResource StatusText}" Visibility="Collapsed"/></Border>
          <Border Style="{StaticResource StatusSegment}" Visibility="{Binding Visibility, ElementName=OutputPauseHint}"><TextBlock x:Name="OutputPauseHint" Text="Pause remains scheduled" Style="{StaticResource StatusText}" Visibility="Collapsed"/></Border>
        </DockPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="OutputResumeButton" Content="Resume" Click="ResumeOutputPauseClicked" Style="{StaticResource StatusButton}" Visibility="Collapsed" AutomationProperties.Name="Resume Chatbox output"/>
          <Button x:Name="OutputPauseButton" Content="Pause" Click="OutputPauseClicked" Style="{StaticResource StatusButton}" AutomationProperties.Name="Pause or change Chatbox output pause">
            <Button.ContentTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding}"/><TextBlock Text="▾" Margin="6,0,0,0" FontSize="10" VerticalAlignment="Center" AutomationProperties.Name=" "/></StackPanel></DataTemplate></Button.ContentTemplate>
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Pause for 5 minutes" Tag="5" Click="PauseOutputSelected"/>
                <MenuItem Header="Pause for 15 minutes" Tag="15" Click="PauseOutputSelected"/>
                <MenuItem Header="Pause for 30 minutes" Tag="30" Click="PauseOutputSelected"/>
                <Separator/>
                <MenuItem x:Name="PauseUntilTrackMenuItem" Header="Pause until next track" Tag="track" Click="PauseOutputSelected"/>
                <MenuItem Header="Pause until I resume" Tag="resume" Click="PauseOutputSelected"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </StackPanel>
        <Border Grid.Column="4" Style="{StaticResource StatusSegment}"><TextBlock x:Name="VersionCaption" Style="{StaticResource Caption}" VerticalAlignment="Center"/></Border>
      </Grid>
    </Border>
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0">
      <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="MinimizeWindow" AutomationProperties.Name="Minimize" ToolTip="Minimize"/>
      <Button x:Name="MaximizeCaptionButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="ToggleMaximizeWindow" AutomationProperties.Name="Maximize or restore" ToolTip="Maximize or restore"/>
      <Button Content="&#xE8BB;" Style="{StaticResource CaptionButton}" Click="CloseWindow" AutomationProperties.Name="Close" ToolTip="Close"/>
    </StackPanel>
  </Grid>
</Window>
