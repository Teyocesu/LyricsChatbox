<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LyricsChatbox" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" x:Class="LyricsChatbox.MainWindow" WindowStyle="None" Title="LyricsChatbox" Icon="Assets/AppIcon.ico" Width="1280" Height="940" MinWidth="820" MinHeight="650" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">

  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="MusicTransportButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="16"/></Style>
    <Style x:Key="MusicPlayButton" TargetType="Button" BasedOn="{StaticResource MusicTransportButton}">
      <Setter Property="Width" Value="46"/><Setter Property="Height" Value="46"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Circle" CornerRadius="23" BorderThickness="1.5" BorderBrush="{DynamicResource AccentBrush}" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="{DynamicResource AccentMutedBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Circle" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource TextBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="46"/><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="10"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/></Style>
    <Style x:Key="DashboardTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="30"/><Setter Property="FontSize" Value="11"/></Style>
    <Style x:Key="StatusPill" TargetType="Border"><Setter Property="Background" Value="{DynamicResource RaisedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="10,5"/></Style>
    <DataTemplate x:Key="DashboardQuickTemplate"><Button Click="UseQuickMessage" Margin="0,0,6,6" Padding="6,8" MinHeight="38" ToolTip="Load as an unsent manual draft"><TextBlock Text="{Binding Name}" TextAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="34"/></Button></DataTemplate>
    <DataTemplate x:Key="QuickMessageTemplate"><Button Content="{Binding Name}" Click="UseQuickMessage" Margin="0,0,8,8" MinWidth="92" ToolTip="Load as an unsent manual draft"/></DataTemplate>
  </Window.Resources>
  <Grid x:Name="ContentRoot">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="194"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <Border x:Name="Sidebar" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Background="{DynamicResource SidebarBrush}" Padding="16,28,16,20">
      <DockPanel>
        <StackPanel x:Name="BrandPanel" DockPanel.Dock="Top" Margin="0,0,0,32">
          <StackPanel Orientation="Horizontal">
            <Image Source="Assets/AppIcon.png" Width="34" Height="34" Margin="4,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="LyricsChatbox" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="VersionCaption" Style="{StaticResource Caption}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <StackPanel x:Name="AboutNavigationPanel" Margin="0,0,0,10">
            <RadioButton x:Name="AboutNav" Tag="About" AutomationProperties.Name="About" GroupName="Navigation" Checked="Navigate" Style="{StaticResource NavigationItem}">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE946;" FontSize="20" Width="24" Margin="0,0,14,0" VerticalAlignment="Center"/>
                <TextBlock Text="About"/>
              </StackPanel>
            </RadioButton>
          </StackPanel>
          <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="10,12">
            <StackPanel>
              <DockPanel>
                <TextBlock x:Name="OutputPowerText" Text="OFF" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.Name="Output power status"/>
                <CheckBox x:Name="EnabledBox" Checked="EnabledChanged" Unchecked="EnabledChanged" AutomationProperties.Name="Enable Chatbox output"><TextBlock Text="Output" FontSize="12"/></CheckBox>
              </DockPanel>
              <TextBlock x:Name="OutputStateText" Text="Off" Style="{StaticResource Caption}" Margin="22,5,0,2"/>
              <TextBlock x:Name="OutputPauseHint" Text="Pause remains scheduled" Style="{StaticResource Caption}" Margin="22,0,0,8" Visibility="Collapsed"/>
              <WrapPanel Margin="0,6,0,0">
              <Button x:Name="OutputResumeButton" Content="Resume" Click="ResumeOutputPauseClicked" Style="{StaticResource SmallButton}" Visibility="Collapsed" Margin="0,0,6,0" AutomationProperties.Name="Resume Chatbox output"/>
              <Button x:Name="OutputPauseButton" Content="Pause" Click="OutputPauseClicked" Style="{StaticResource SmallButton}" AutomationProperties.Name="Pause or change Chatbox output pause">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Pause for 5 minutes" Tag="5" Click="PauseOutputSelected"/>
                    <MenuItem Header="Pause for 15 minutes" Tag="15" Click="PauseOutputSelected"/>
                    <MenuItem Header="Pause for 30 minutes" Tag="30" Click="PauseOutputSelected"/>
                    <Separator/>
                    <MenuItem x:Name="PauseUntilTrackMenuItem" Header="Pause until next track" Tag="track" Click="PauseOutputSelected"/>
                    <MenuItem Header="Pause until I resume" Tag="resume" Click="PauseOutputSelected"/>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="NavigationPanel">
          <RadioButton Tag="Home" AutomationProperties.Name="Home" GroupName="Navigation" IsChecked="True" Checked="Navigate" Style="{StaticResource NavigationItem}">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons" Text="" FontSize="20" Width="24" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <TextBlock Text="Home"/>
            </StackPanel>
          </RadioButton>
          <RadioButton Tag="Display" AutomationProperties.Name="Display" GroupName="Navigation" Checked="Navigate" Style="{StaticResource NavigationItem}">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7F4;" FontSize="20" Width="24" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <TextBlock Text="Display"/>
            </StackPanel>
          </RadioButton>
          <RadioButton Tag="Manual" AutomationProperties.Name="Manual" GroupName="Navigation" Checked="Navigate" Style="{StaticResource NavigationItem}">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8F2;" FontSize="20" Width="24" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <TextBlock Text="Manual"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="SettingsNav" Tag="Settings" AutomationProperties.Name="Settings" GroupName="Navigation" Checked="Navigate" Style="{StaticResource NavigationItem}">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons" Text="" FontSize="20" Width="24" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <TextBlock Text="Settings"/>
            </StackPanel>
          </RadioButton>
        </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <Grid x:Name="ContentPanel" Grid.Column="1" Margin="28,24,28,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel x:Name="HeadingPanel" Margin="0,0,0,20">
        <TextBlock x:Name="PageTitle" Text="Home" FontSize="28" FontWeight="SemiBold"/>
      </StackPanel>
      <ScrollViewer x:Name="HomePage" Grid.Row="1" Visibility="Visible" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
        <Grid>
        <Border x:Name="HomeFit">
        <Grid x:Name="HomeDashboard"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border x:Name="NowPlayingCard" Style="{StaticResource Card}" Background="{DynamicResource HeroBrush}" Margin="0,0,0,12" Padding="0">
            <Grid ClipToBounds="True" SizeChanged="HeroSurfaceSizeChanged">
              <Grid x:Name="HeroArtworkLayer" IsHitTestVisible="False" ClipToBounds="True">
                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=ArtworkTintBox}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Source, ElementName=ArtImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Border Margin="-32" Opacity="0.48" CacheMode="BitmapCache">
                  <Border.Background><ImageBrush ImageSource="{Binding Source, ElementName=ArtImage}" Stretch="UniformToFill" AlignmentY="Center"/></Border.Background>
                  <Border.Effect><BlurEffect Radius="28" RenderingBias="Performance"/></Border.Effect>
                </Border>
                <Border Background="{DynamicResource SurfaceBrush}" Opacity="0.5"/>
                <Border Background="{DynamicResource SurfaceBrush}"><Border.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF000000" Offset="0"/><GradientStop Color="#E6000000" Offset="0.30"/><GradientStop Color="#44000000" Offset="0.68"/><GradientStop Color="#10000000" Offset="1"/></LinearGradientBrush></Border.OpacityMask></Border>
              </Grid>
            <Grid x:Name="HeroGrid" Margin="18">
              <Grid.ColumnDefinitions><ColumnDefinition x:Name="ArtworkColumn" Width="216"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border x:Name="ArtworkFrame" Width="194" Height="194" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource AccentMutedBrush}">
                <Grid><Grid.OpacityMask><VisualBrush><VisualBrush.Visual><Border Width="194" Height="194" CornerRadius="10" Background="White"/></VisualBrush.Visual></VisualBrush></Grid.OpacityMask>
                  <Image x:Name="ArtImage" Stretch="UniformToFill" AutomationProperties.Name="Album artwork"/>
                  <TextBlock x:Name="ArtFallback" Text="♫" FontSize="56" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel x:Name="HeroStatusRow" LastChildFill="False" Margin="0,0,0,8">
                  <TextBlock Text="NOW PLAYING" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                  <Button x:Name="ChoosePlaybackSourceButton" DockPanel.Dock="Right" Content="Choose source" Click="GoToPlaybackSourceSettings" Visibility="Collapsed" Margin="8,0,0,0"/>
                  <Border DockPanel.Dock="Right" Style="{StaticResource StatusPill}"><TextBlock x:Name="SourceText" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></Border>
                </DockPanel>
                <Grid x:Name="HeroContentGrid" Grid.Row="1">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel x:Name="TrackMetadata" Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TrackText" Text="No track playing" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <TextBlock x:Name="ArtistText" TextWrapping="NoWrap" FontSize="15" Foreground="{DynamicResource TextBrush}" Margin="0,5,0,0" MaxHeight="42" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="AlbumText" TextWrapping="NoWrap" Style="{StaticResource Caption}" Margin="0,4,0,0" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                    <Border x:Name="HeroProviderBadge" Style="{StaticResource StatusPill}" HorizontalAlignment="Left" Margin="0,10,0,0"><TextBlock x:Name="LyricsStatusText" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></Border>
                  </StackPanel>
                  <Border x:Name="HeroLyricPanel" Grid.Column="1" BorderThickness="0" Padding="22,4,0,4" VerticalAlignment="Center">
                    <StackPanel>
                      <TextBlock x:Name="LyricText" Text="—" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="24" FontWeight="Light" TextAlignment="Center" LineHeight="30" LineStackingStrategy="BlockLineHeight" MaxHeight="144" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                      <Border Width="22" Height="2" CornerRadius="1" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    </StackPanel>
                  </Border>
                </Grid>
                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                  <ProgressBar x:Name="PositionProgress" Maximum="1" Height="4" BorderThickness="0" Background="{DynamicResource LineBrush}" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="Playback progress" ToolTip="Seeking is not available here"/>
                  <TextBlock x:Name="PositionText" Style="{StaticResource Caption}" Margin="0,7,0,0"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Button x:Name="ShuffleButton" Style="{StaticResource MusicTransportButton}" Content="&#xE8B1;" FontFamily="Segoe Fluent Icons" Tag="Shuffle" Click="TransportClicked" ToolTipService.ShowOnDisabled="True" ToolTip="Shuffle is unavailable" AutomationProperties.Name="Shuffle"/>
                    <Button x:Name="PreviousButton" Style="{StaticResource MusicTransportButton}" Content="&#xE892;" FontFamily="Segoe Fluent Icons" Tag="Previous" Click="TransportClicked" ToolTip="Previous track" AutomationProperties.Name="Previous track"/>
                    <Button x:Name="PlayPauseButton" Style="{StaticResource MusicPlayButton}" Content="&#xE768;" FontFamily="Segoe Fluent Icons" Tag="PlayPause" Click="TransportClicked" Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" Margin="8,0" ToolTip="Play or pause" AutomationProperties.Name="Play or pause"/>
                    <Button x:Name="NextButton" Style="{StaticResource MusicTransportButton}" Content="&#xE893;" FontFamily="Segoe Fluent Icons" Tag="Next" Click="TransportClicked" ToolTip="Next track" AutomationProperties.Name="Next track"/>
                    <Button x:Name="RepeatButton" Style="{StaticResource MusicTransportButton}" Content="&#xE8EE;" FontFamily="Segoe Fluent Icons" Tag="Repeat" Click="TransportClicked" ToolTipService.ShowOnDisabled="True" ToolTip="Repeat is unavailable" AutomationProperties.Name="Repeat" Margin="8,0,16,0"/>
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE767;" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="MusicVolumeSlider" ValueChanged="MusicVolumeChanged" Minimum="0" Maximum="1" Width="90" IsEnabled="False" IsMoveToPointEnabled="True" SmallChange="0.02" LargeChange="0.1" AutomationProperties.Name="Music volume" ToolTip="Music volume" PreviewMouseLeftButtonUp="VolumeReleased" KeyUp="VolumeKeyReleased"/>
                  </StackPanel>
                  <TextBlock x:Name="TransportStatus" Style="{StaticResource Caption}" FontSize="10" Visibility="Collapsed"/>
                </StackPanel>
              </Grid>
            </Grid>
            </Grid>
          </Border>
          <Grid x:Name="HomePreferencesGrid" Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border x:Name="ProfilesCard" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="14">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8"><Button Content="Manage" Click="ManageProfiles" DockPanel.Dock="Right" Style="{StaticResource SmallButton}"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8D6;" Margin="0,0,10,0"/><TextBlock Text="Profiles" Style="{StaticResource DashboardTitle}"/></StackPanel></DockPanel>
                <ListBox x:Name="ProfileCards" Grid.Row="1" SelectionChanged="SelectProfile" SelectedValuePath="Id" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Saved display profiles" VerticalAlignment="Center" Padding="0">
                  <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource PresetItem}"><Setter Property="Width" Value="102"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,0,8,4"/></Style></ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate><DataTemplate><StackPanel><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,5"><TextBlock FontFamily="Segoe Fluent Icons" FontSize="16"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE8A4;"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Preset}" Value="Song + Lyrics"><Setter Property="Text" Value="&#xE8D6;"/></DataTrigger><DataTrigger Binding="{Binding Preset}" Value="Custom"><Setter Property="Text" Value="&#xE713;"/></DataTrigger><DataTrigger Binding="{Binding Preset}" Value="Status / Time"><Setter Property="Text" Value="&#xE916;"/></DataTrigger><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Preset}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
            <Border x:Name="ContextCard" Grid.Column="1" Style="{StaticResource Card}" Padding="14">
              <StackPanel>
                <TextBlock Text="Lyric context" Style="{StaticResource DashboardTitle}" Margin="0,0,0,8"/>
                <ListBox x:Name="ContextBox" SelectionChanged="ContextChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Lyric context mode" Padding="0" ToolTip="{Binding Text, ElementName=ContextHint}">
                  <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource PresetItem}"><Setter Property="Padding" Value="7,7"/><Setter Property="Margin" Value="0,0,5,5"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style></ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="11" TextAlignment="Center"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="ContextHint" Text="Adds nearby lyrics when they fit. The current lyric always stays." Style="{StaticResource Caption}" Margin="0,4,0,0" Visibility="Collapsed"/>
              </StackPanel>
            </Border>
          </Grid>
          <ScrollViewer x:Name="HomeDetailsScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="HomeDetailsStack"><Grid x:Name="HomeDetailsGrid" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.38*"/><ColumnDefinition Width="1.12*"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ContentControl x:Name="HomePreviewHost" Margin="0,0,12,0" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"/>
            <Border x:Name="InspectorCard" Grid.Column="1" Style="{StaticResource Card}" Padding="18" Margin="0,0,12,0" Height="244" VerticalAlignment="Top">
              <ScrollViewer x:Name="InspectorScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <TextBlock Text="Lyrics details" Style="{StaticResource DashboardTitle}" Margin="0,0,0,14"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="Source" Style="{StaticResource Caption}" Margin="0,0,12,4"/><TextBlock Grid.Row="0" Grid.Column="1" x:Name="InspectorSource" Text="—" FontSize="12" Margin="0,0,0,4" />
<TextBlock Grid.Row="1" Text="Cache" Style="{StaticResource Caption}" Margin="0,0,12,4"/><TextBlock Grid.Row="1" Grid.Column="1" x:Name="InspectorCache" Text="—" FontSize="12" Margin="0,0,0,4" />
<TextBlock Grid.Row="2" Text="{x:Static local:PresentationText.TrackLyricsDurationLabel}" Style="{StaticResource Caption}" Margin="0,0,12,4"/><TextBlock Grid.Row="2" Grid.Column="1" x:Name="InspectorDuration" Text="—" FontSize="12" Margin="0,0,0,4" />
<TextBlock Grid.Row="3" Text="Global offset" Style="{StaticResource Caption}" Margin="0,0,12,4"/><TextBlock Grid.Row="3" Grid.Column="1" x:Name="InspectorGlobalOffset" Text="—" FontSize="12" Margin="0,0,0,4" />
<TextBlock Grid.Row="4" Text="Saved offset" Style="{StaticResource Caption}" Margin="0,0,12,4"/><TextBlock Grid.Row="4" Grid.Column="1" x:Name="InspectorSavedOffset" Text="—" FontSize="12" Margin="0,0,0,4" />
<TextBlock Grid.Row="5" Text="Effective offset" Style="{StaticResource Caption}" Margin="0,0,12,4"/><TextBlock Grid.Row="5" Grid.Column="1" x:Name="InspectorEffectiveOffset" Text="—" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource AccentBrush}" />
</Grid>
                <Expander Header="Recording &amp; timing" FontSize="12">
                  <StackPanel Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="Match" Style="{StaticResource Caption}" Margin="0,0,12,4"/><TextBlock Grid.Row="0" Grid.Column="1" x:Name="InspectorMatch" Text="—" FontSize="12" Margin="0,0,0,4" />
<TextBlock Grid.Row="1" Text="Manual match" Style="{StaticResource Caption}" Margin="0,0,12,4"/><TextBlock Grid.Row="1" Grid.Column="1" x:Name="InspectorManual" Text="—" FontSize="12" Margin="0,0,0,4" />
<TextBlock Grid.Row="2" Text="Ignored" Style="{StaticResource Caption}" Margin="0,0,12,4"/><TextBlock Grid.Row="2" Grid.Column="1" x:Name="InspectorIgnored" Text="—" FontSize="12" Margin="0,0,0,4" />
                </Grid>
                    <Button Content="Forget manual match" Click="ForgetMatch" IsEnabled="{Binding IsEnabled, ElementName=ForgetMatchButton}" Style="{StaticResource SmallButton}" Margin="0,2,0,12"/>
                    <DockPanel><TextBlock Text="Lyric timing" FontWeight="SemiBold"/><TextBlock x:Name="OffsetText" Text="0.0 s" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></DockPanel>
                    <Slider x:Name="OffsetSlider" ToolTip="Positive timing values show lyrics later." Minimum="-5" Maximum="5" TickFrequency="0.1" SmallChange="0.1" LargeChange="0.5" IsSnapToTickEnabled="True" ValueChanged="OffsetChanged" AutomationProperties.Name="Lyric offset in seconds" Margin="0,6,0,2" />

                    <TextBlock x:Name="CorrectionStatus" Style="{StaticResource Caption}" Margin="0,4,0,8"/>
                    <WrapPanel><Button x:Name="SaveSongButton" Content="Save for song" Click="SaveSongCorrection" Style="{StaticResource SmallButton}" Margin="0,0,6,6"/><Button x:Name="ResetSongButton" Content="Reset song" Click="ResetSongCorrection" Style="{StaticResource SmallButton}" Margin="0,0,0,6"/><Button Content="Use globally" Click="UseGlobalCorrection" Style="{StaticResource SmallButton}"/></WrapPanel>
                  </StackPanel>
                </Expander>
              </StackPanel>
              </ScrollViewer>
            </Border>
            <Border x:Name="QuickMessagesCard" Grid.Column="2" Style="{StaticResource Card}" Padding="18">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Quick messages" Style="{StaticResource DashboardTitle}"/>
                <TextBlock Grid.Row="1" Text="Choose a draft, then Send." Style="{StaticResource Caption}" Margin="0,6,0,16"/>
                <ScrollViewer Grid.Row="2" MaxHeight="128" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="HomeQuickMessages" ItemTemplate="{StaticResource DashboardQuickTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="QuickEmptyText" Grid.Row="3" Text="Add reusable messages in Manual." Style="{StaticResource Caption}" Visibility="Collapsed"/>
