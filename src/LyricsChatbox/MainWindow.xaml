                <Button Content="VRChat profile" Click="OpenVrChatProfile" Margin="0,0,8,8" AutomationProperties.Name="VRChat profile"/>
                <Button Content="Copy Discord: teyocesu" Click="CopyDiscordName" Margin="0,0,0,8" AutomationProperties.Name="Copy Discord username"/>
