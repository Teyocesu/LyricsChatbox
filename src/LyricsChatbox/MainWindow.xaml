            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe Fluent Icons" Text="" FontSize="22" Width="26" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <TextBlock Text="Settings" FontSize="15"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="AboutNav" Tag="About" AutomationProperties.Name="About" GroupName="Navigation" Checked="Navigate" Style="{StaticResource NavigationItem}">
