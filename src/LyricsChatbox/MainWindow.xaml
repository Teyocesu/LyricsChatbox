                <Button Content="View repository" Click="ViewRepository" Margin="0,0,8,8" AutomationProperties.Name="View repository"/>
                <Button Content="View releases" Click="ViewReleases" Margin="0,0,8,8" AutomationProperties.Name="View releases"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,8,16">
            <StackPanel>
              <TextBlock Text="Updates" Style="{StaticResource SectionTitle}"/>
