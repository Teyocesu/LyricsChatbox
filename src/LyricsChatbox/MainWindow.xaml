                <TextBlock x:Name="LyricText" Grid.Row="1" Grid.ColumnSpan="2" Text="—" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="Light" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                  <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><Trigger Property="Text" Value="—"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Trigger></Style.Triggers></Style></TextBlock.Style>
